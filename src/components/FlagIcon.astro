---
/**
 * FlagIcon - Inline SVG flag for a locale.
 *
 * Drawn inline rather than using emoji flags (🇭🇷, 🇬🇧, ...), because Windows
 * renders those as two-letter codes and Chrome on Android drops them entirely.
 *
 * All flags share a 3:2 viewBox so a row of them lines up at the same size.
 * They are decorative: the surrounding link carries the accessible name.
 */
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className = "" } = Astro.props;

// Repeated <clipPath> ids would collide when this renders more than once on a
// page, so the Union Jack clip gets a per-instance suffix.
const uid = Math.random().toString(36).slice(2, 9);

// Croatian chequy: five columns starting with red in the top-left corner.
const shieldX = 23;
const shieldY = 9;
const cellW = 2.8;
const cellH = 3.75;
const columns = 5;
const rows = 6;
const checks: Array<{ x: number; y: number }> = [];
for (let row = 0; row < rows; row += 1) {
  for (let column = 0; column < columns; column += 1) {
    // Red where row and column parity match, giving the alternating pattern.
    if ((row + column) % 2 === 0) {
      checks.push({ x: shieldX + column * cellW, y: shieldY + row * cellH });
    }
  }
}
const shieldPath = `M${shieldX} ${shieldY} h${columns * cellW} v11 c0 6 -${(columns * cellW) / 2} 11 -${(columns * cellW) / 2} 11 s-${(columns * cellW) / 2} -5 -${(columns * cellW) / 2} -11 z`;
---

<svg
  viewBox="0 0 60 40"
  class={className}
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  {
    locale === "hr" && (
      <g>
        {/* Red, white and blue bands */}
        <rect width="60" height="13.34" fill="#ff0000" />
        <rect y="13.34" width="60" height="13.33" fill="#ffffff" />
        <rect y="26.67" width="60" height="13.33" fill="#171796" />
        {/* Chequy shield */}
        <path d={shieldPath} fill="#ffffff" stroke="#171796" stroke-width="1" />
        <clipPath id={`shield-${uid}`}>
          <path d={shieldPath} />
        </clipPath>
        <g clip-path={`url(#shield-${uid})`}>
          {checks.map((cell) => (
            <rect x={cell.x} y={cell.y} width={cellW} height={cellH} fill="#ff0000" />
          ))}
        </g>
      </g>
    )
  }

  {
    locale === "en" && (
      <g>
        {/*
          Union Jack. The red diagonals are counterchanged: offset to one side of
          each white saltire arm rather than centred on it. The clip path selects
          the alternating half-quadrants that produces the offset.
        */}
        <clipPath id={`quarters-${uid}`}>
          <path d="M30,20 h30 v20 z v-20 h-30 z h-30 v-20 z v20 h30 z" />
        </clipPath>
        <rect width="60" height="40" fill="#012169" />
        <path d="M0,0 L60,40 M60,0 L0,40" stroke="#ffffff" stroke-width="8" />
        <path
          d="M0,0 L60,40 M60,0 L0,40"
          clip-path={`url(#quarters-${uid})`}
          stroke="#c8102e"
          stroke-width="5"
        />
        <path d="M30,0 v40 M0,20 h60" stroke="#ffffff" stroke-width="13" />
        <path d="M30,0 v40 M0,20 h60" stroke="#c8102e" stroke-width="8" />
      </g>
    )
  }

  {
    locale === "de" && (
      <g>
        {/* Black, red and gold bands */}
        <rect width="60" height="13.34" fill="#000000" />
        <rect y="13.34" width="60" height="13.33" fill="#dd0000" />
        <rect y="26.67" width="60" height="13.33" fill="#ffce00" />
      </g>
    )
  }

  {
    locale === "it" && (
      <g>
        {/* Green, white and red bands */}
        <rect width="20" height="40" fill="#009246" />
        <rect x="20" width="20" height="40" fill="#ffffff" />
        <rect x="40" width="20" height="40" fill="#ce2b37" />
      </g>
    )
  }
</svg>
