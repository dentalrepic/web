---
/**
 * FlagIcon - Inline SVG flag for a locale.
 *
 * Drawn inline rather than using emoji flags (🇭🇷, 🇬🇧, ...), because Windows
 * renders those as two-letter codes and Chrome on Android drops them entirely.
 *
 * All flags share a 3:2 viewBox so a row of them lines up at the same size.
 * They are decorative: the surrounding link carries the accessible name.
 *
 * The Croatian and British flags are the two fiddly ones, and both are built
 * from geometry measured off the public-domain reference drawings rather than
 * eyeballed. See the comments on each.
 */
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className = "" } = Astro.props;

// Repeated <clipPath> ids would collide when this renders more than once on a
// page, so every clip id gets a per-instance suffix.
const uid = Math.random().toString(36).slice(2, 9);

/*
 * Croatian coat of arms.
 *
 * Proportions are taken from the official flag drawing, as fractions of the
 * flag's width and height, then expressed in the 60x40 viewBox:
 *
 *   escutcheon   x 0.390 .. 0.610, y 0.262 .. 0.762   (white, red outline)
 *   chequy field x 0.397 .. 0.602, y 0.290 .. 0.750   (inset, so a white
 *                                                      border shows around it)
 *   crown        x 0.385 .. 0.615, five shields in a shallow arc
 *
 * Two details that are easy to get wrong and that the previous drawing did get
 * wrong: the chequy is 5x5 with a RED cell at the top left, and the escutcheon
 * is outlined in red, not blue.
 */
const shieldPath = (x0: number, x1: number, yTop: number, yTip: number, curve: number) => {
  const w = x1 - x0;
  const straight = yTop + (yTip - yTop) * 0.52;
  return (
    `M${x0} ${yTop} H${x1} V${straight} ` +
    `C${x1} ${yTip - curve} ${x0 + w * 0.8} ${yTip} ${(x0 + x1) / 2} ${yTip} ` +
    `C${x0 + w * 0.2} ${yTip} ${x0} ${yTip - curve} ${x0} ${straight} Z`
  );
};

// Outer escutcheon: its top edge overlaps the crown bases, which is what makes
// the crown read as sitting behind the shield.
const hrOuter = shieldPath(23.4, 36.6, 10.48, 30.48, 1.8);
// Inner chequy field.
const hrInner = shieldPath(23.8, 36.1, 11.6, 30, 1.68);

const hrCellW = 2.46;
const hrCellH = 3.16;
const hrChecks: Array<{ x: number; y: number }> = [];
// Six rows of cells are laid down although the field is five deep: the extra
// row keeps the pointed base chequered instead of leaving a white wedge. The
// clip path trims it.
for (let row = 0; row < 6; row += 1) {
  for (let column = 0; column < 5; column += 1) {
    if ((row + column) % 2 === 0) {
      hrChecks.push({ x: 23.8 + column * hrCellW, y: 11.6 + row * hrCellH });
    }
  }
}

// Crown: five shields, alternating light and dark blue, centre one highest.
const hrCrownLight = "#0093dd";
const hrCrownDark = "#171796";
const hrCrownTops = [6.4, 5.76, 5.47, 5.76, 6.4];
const hrCrownFills = [hrCrownLight, hrCrownDark, hrCrownLight, hrCrownDark, hrCrownLight];
const hrCrownStepX = 2.76;
const hrCrownBase = 11;
const hrCrown = hrCrownTops.map((top, index) => {
  const x = 23.1 + index * hrCrownStepX;
  const w = hrCrownStepX;
  const h = hrCrownBase - top;
  return {
    fill: hrCrownFills[index],
    d:
      `M${x + w * 0.04} ${top + h * 0.36} L${x + w / 2} ${top} L${x + w * 0.96} ${top + h * 0.36} ` +
      `L${x + w * 0.96} ${top + h} L${x + w * 0.04} ${top + h} Z`,
  };
});
---

<svg
  viewBox="0 0 60 40"
  class={className}
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  {
    locale === "hr" && (
      <g>
        {/* Red, white and blue bands */}
        <rect width="60" height="13.334" fill="#ff0000" />
        <rect y="13.334" width="60" height="13.333" fill="#ffffff" />
        <rect y="26.667" width="60" height="13.333" fill="#171796" />
        {/* Crown first, so the escutcheon overlaps its bases */}
        {hrCrown.map((piece) => (
          <path d={piece.d} fill={piece.fill} stroke="#ffffff" stroke-width="0.4" />
        ))}
        <path d={hrOuter} fill="#ffffff" stroke="#ff0000" stroke-width="0.55" />
        <clipPath id={`hr-shield-${uid}`}>
          <path d={hrInner} />
        </clipPath>
        <g clip-path={`url(#hr-shield-${uid})`}>
          {hrChecks.map((cell) => (
            <rect x={cell.x} y={cell.y} width={hrCellW} height={hrCellH} fill="#ff0000" />
          ))}
        </g>
      </g>
    )
  }

  {
    locale === "en" && (
      /*
       * Union Flag, drawn on the official 60x30 construction and stretched to
       * this component's 60x40 box by the nested svg, so the path data and
       * stroke widths are the reference ones rather than rescaled guesses.
       *
       * The clip path is what counterchanges the red diagonals: it selects the
       * half of each quadrant that puts red on the clockwise side of the white
       * saltire arm. Getting one of its four subpaths backwards produces a flag
       * that looks plausible but is mirrored, which is the bug this replaces.
       */
      <svg viewBox="0 0 60 30" width="60" height="40" preserveAspectRatio="none">
        <clipPath id={`uk-counterchange-${uid}`}>
          <path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" />
        </clipPath>
        <path d="M0,0 v30 h60 v-30 z" fill="#012169" />
        <path d="M0,0 L60,30 M60,0 L0,30" stroke="#ffffff" stroke-width="6" />
        <path
          d="M0,0 L60,30 M60,0 L0,30"
          clip-path={`url(#uk-counterchange-${uid})`}
          stroke="#c8102e"
          stroke-width="4"
        />
        <path d="M30,0 v30 M0,15 h60" stroke="#ffffff" stroke-width="10" />
        <path d="M30,0 v30 M0,15 h60" stroke="#c8102e" stroke-width="6" />
      </svg>
    )
  }

  {
    locale === "de" && (
      <g>
        {/* Black, red and gold bands */}
        <rect width="60" height="13.334" fill="#000000" />
        <rect y="13.334" width="60" height="13.333" fill="#dd0000" />
        <rect y="26.667" width="60" height="13.333" fill="#ffce00" />
      </g>
    )
  }

  {
    locale === "it" && (
      <g>
        {/* Green, white and red bands */}
        <rect width="20" height="40" fill="#009246" />
        <rect x="20" width="20" height="40" fill="#ffffff" />
        <rect x="40" width="20" height="40" fill="#ce2b37" />
      </g>
    )
  }
</svg>
