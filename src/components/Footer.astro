---
import site from "../data/site.json";
import SocialLinks from "./SocialLinks.astro";
import { localeHtmlLang, type Locale } from "../i18n/config";
import { useTranslations } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const year = new Date().getFullYear();

/*
 * Opening hours, Monday to Friday, from site.openingHours: the same data the
 * Dentist structured data publishes, so the two cannot drift apart. Day names
 * come from Intl in the page's language, and a day missing from the data is
 * shown as closed. The weekend is left out rather than listed as closed.
 */
const weekdays = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];
const dayName = new Intl.DateTimeFormat(localeHtmlLang[locale], { weekday: "long" });
// 2024-01-01 was a Monday.
const labelFor = (index: number) => {
  const name = dayName.format(new Date(Date.UTC(2024, 0, 1 + index, 12)));
  return name.charAt(0).toLocaleUpperCase(localeHtmlLang[locale]) + name.slice(1);
};
const time = (value: string) => value.replace(/^0/, "");
const hours = weekdays.map((day, index) => {
  const entry = site.openingHours.find((hoursEntry) => hoursEntry.days.includes(day));
  return {
    label: labelFor(index),
    value: entry ? `${time(entry.opens)} - ${time(entry.closes)}` : t.footer.closed,
    closed: !entry,
  };
});
---

<footer class="bg-theme-sand text-black">
  <div class="container py-14">
    <!--
      Phones stack the clinic text, the hours beside the contact, then the
      copyright last; from lg the copyright moves up under the clinic text and
      the hours and contact take the right-hand column. Below lg the grid has
      two columns, so the social links line up under the contact column.
    -->
    <div
      class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-12 sm:gap-x-10 lg:grid-cols-[minmax(0,562px)_auto] lg:justify-between lg:gap-x-24 lg:gap-y-14"
    >
      <!-- About the clinic -->
      <div class="col-span-2 space-y-2 lg:col-span-1 lg:col-start-1 lg:row-start-1">
        <p class="text-base leading-7 tracking-[0.02em]">{t.brand.name}</p>
        <p class="text-sm leading-6 text-black/55">{t.footer.description}</p>
      </div>

      <div class="contents lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:flex lg:gap-10">
        <!-- Opening hours -->
        <div class="shrink-0">
          <h2 class="pb-4 text-sm font-normal leading-6 tracking-normal">
            {t.footer.hoursHeading}
          </h2>
          <dl class="space-y-1 text-sm leading-6">
            {
              hours.map((row) => (
                <div class:list={["flex gap-2", row.closed ? "font-semibold" : "text-black/55"]}>
                  <dt class="w-[5.5rem] shrink-0">{row.label}</dt>
                  <dd>{row.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <!-- Contact -->
        <div>
          <h2 class="pb-4 text-sm font-normal leading-6 tracking-normal">
            {t.footer.contactHeading}
          </h2>
          <div class="space-y-4 text-sm leading-6 text-black/55">
            <p class="text-sm leading-6">
              {site.contact.addressLine1}<br />
              {site.contact.addressLine2}, {site.contact.country}
            </p>
            <p class="text-sm leading-6">
              {t.contact.phoneLabel}:{" "}
              <a href={site.contact.phoneHref} class="whitespace-nowrap hover:text-black hover:underline">
                {site.contact.phone}
              </a>
              <br />
              {t.contact.emailLabel}:{" "}
              <a href={`mailto:${site.contact.email}`} class="hover:text-black hover:underline">
                {site.contact.email}
              </a>
            </p>
            <!--
              From lg the social links sit here, as far below the e-mail line
              as it sits below the phone; phones show them by the copyright.
            -->
            <SocialLinks class="-mt-2 hidden lg:flex" />
          </div>
        </div>
      </div>

      <!--
        Copyright, then the designer's credit as her design sets it. Phones put
        the social links beside the copyright, under the contact column, and
        the credit on its own row below; from lg the credit follows the
        copyright after a bar.
      -->
      <div
        class="contents text-xs leading-[18px] tracking-[0.02em] lg:col-start-1 lg:row-start-2 lg:flex lg:items-center"
      >
        <p class="self-center text-xs leading-[18px]">&copy; {year} {t.brand.name}</p>
        <SocialLinks class="flex self-center lg:hidden" />
        <span class="mx-1 hidden lg:inline" aria-hidden="true">|</span>
        <a
          href="https://www.lidijajankovic.com"
          target="_blank"
          rel="noopener"
          class="col-span-2 -mt-10 justify-self-start text-black/50 underline transition-colors hover:text-black lg:mt-0"
        >
          Made by Lidija Jankovic
        </a>
      </div>
    </div>
  </div>
</footer>
