---
import Icon from "./Icon.astro";
import logo from "../assets/logo-dcr.svg";
import site from "../data/site.json";
import type { Locale } from "../i18n/config";
import { localizePath, useTranslations } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const year = new Date().getFullYear();

// A representative slice of the treatment catalogue for the footer.
const footerServices = t.services.groups.map((group) => group.title);
---

<footer class="bg-theme-primary-darker text-white">
  <div class="container section-sm">
    <div class="grid gap-10 lg:grid-cols-4">
      <!-- Brand and contact -->
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <!-- White tile behind the mark: the logo's own teal ground would
               disappear against the dark footer -->
          <img
            src={logo.src}
            alt={t.brand.logoAlt}
            width="48"
            height="48"
            class="w-12 h-12 rounded-xl bg-white p-1"
            loading="lazy"
          />
          <span class="text-xl lg:text-2xl font-bold text-white">
            {t.brand.name}
          </span>
        </div>

        <ul class="space-y-3 mb-6">
          <li class="flex items-start">
            <Icon name="location" size="sm" class="text-theme-primary-lighter mt-1 mr-3 flex-shrink-0" />
            <p class="text-sm text-white/90">
              {site.contact.addressLine1}<br />{site.contact.addressLine2}
            </p>
          </li>
          <li class="flex items-start">
            <Icon name="phone" size="sm" class="text-theme-primary-lighter mt-1 mr-3 flex-shrink-0" />
            <p class="text-sm text-white/90">
              <a href={site.contact.phoneHref} class="hover:text-white">
                {site.contact.phone}
              </a>
              <span class="block text-white/70">{t.common.callUsToday}</span>
            </p>
          </li>
          <li class="flex items-start">
            <Icon name="email" size="sm" class="text-theme-primary-lighter mt-1 mr-3 flex-shrink-0" />
            <p class="text-sm text-white/90">
              <a href={`mailto:${site.contact.email}`} class="hover:text-white">
                {site.contact.email}
              </a>
            </p>
          </li>
        </ul>

        <p class="text-sm leading-relaxed text-white/80 max-w-xl">
          {t.footer.description}
        </p>
      </div>

      <!-- Services -->
      <div>
        <h2 class="text-base font-semibold mb-4 text-white">
          {t.footer.servicesHeading}
        </h2>
        <ul class="space-y-2">
          {
            footerServices.map((service) => (
              <li>
                <a
                  href={localizePath("/services", locale)}
                  class="text-sm text-white/80 hover:text-white"
                >
                  {service}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Opening hours -->
      <div>
        <h2 class="text-base font-semibold mb-4 text-white">
          {t.footer.hoursHeading}
        </h2>
        <dl class="space-y-1.5">
          {
            t.common.openingHoursRows.map((row) => (
              <div class="flex justify-between gap-4 text-sm">
                <dt class="text-white/80">{row.day}</dt>
                <dd class="text-white/90 whitespace-nowrap">{row.hours}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-10 pt-6 border-t border-white/20 flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <p class="text-sm text-white/70">
        &copy; {year} {t.brand.name}. {t.footer.rightsReserved}.
      </p>
      <nav class="flex flex-wrap justify-center gap-x-4 gap-y-2">
        {
          t.nav.links.map((link) => (
            <a
              href={localizePath(link.href, locale)}
              class="text-sm text-white/80 hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
