---
import site from "../data/site.json";
import SocialLinks from "./SocialLinks.astro";
import { localeHtmlLang, type Locale } from "../i18n/config";
import { useTranslations } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const year = new Date().getFullYear();

/*
 * Opening hours, Monday to Friday, from site.openingHours: the same data the
 * Dentist structured data publishes, so the two cannot drift apart. Day names
 * come from Intl in the page's language, and a day missing from the data is
 * shown as closed. The weekend is left out rather than listed as closed.
 */
const weekdays = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];
const dayName = new Intl.DateTimeFormat(localeHtmlLang[locale], { weekday: "long" });
// 2024-01-01 was a Monday.
const labelFor = (index: number) => {
  const name = dayName.format(new Date(Date.UTC(2024, 0, 1 + index, 12)));
  return name.charAt(0).toLocaleUpperCase(localeHtmlLang[locale]) + name.slice(1);
};
const time = (value: string) => value.replace(/^0/, "");
const hours = weekdays.map((day, index) => {
  const entry = site.openingHours.find((hoursEntry) => hoursEntry.days.includes(day));
  return {
    label: labelFor(index),
    value: entry ? `${time(entry.opens)} - ${time(entry.closes)}` : t.footer.closed,
    closed: !entry,
  };
});
---

<footer class="bg-theme-sand text-black">
  <div class="container py-6 lg:py-14">
    <!--
      Follows the footer designs. Phones stack the clinic text, the hours
      beside the contact, then the copyright, 24px apart. From lg the clinic
      text has the copyright 48px below it, and the hours and the contact are
      spread across the rest of the row.
    -->
    <div
      class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-6 lg:grid-cols-[minmax(0,562px)_auto_minmax(161px,auto)] lg:justify-between lg:gap-x-10 lg:gap-y-12"
    >
      <!-- About the clinic -->
      <div class="col-span-2 space-y-2 lg:col-span-1 lg:col-start-1 lg:row-start-1">
        <p class="text-base leading-7 tracking-[0.02em]">{t.brand.name}</p>
        <p class="text-sm leading-6 text-black/55">{t.footer.description}</p>
      </div>

      <!-- Opening hours -->
      <div class="lg:col-start-2 lg:row-span-2 lg:row-start-1">
        <h2 class="pb-4 text-sm font-normal leading-6 tracking-normal lg:pb-6">
          {t.footer.hoursHeading}
        </h2>
        <!-- The day column is as wide as its longest name, 74px at least -->
        <dl class="grid grid-cols-[auto_auto] gap-x-2 gap-y-2 text-sm leading-6">
          {
            hours.map((row) => (
              <div class:list={["contents", row.closed ? "font-semibold" : "text-black/55"]}>
                <dt class="min-w-[74px]">{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Contact: the number and address without labels, then the social links -->
      <div class="lg:col-start-3 lg:row-span-2 lg:row-start-1">
        <h2 class="pb-3 text-sm font-normal leading-6 tracking-normal lg:pb-5">
          {t.footer.contactHeading}
        </h2>
        <div class="space-y-4 text-sm leading-6 text-black/55">
          <p class="text-sm leading-6">
            {site.contact.addressLine1}<br />
            {site.contact.addressLine2}, {site.contact.country}
          </p>
          <p class="text-sm leading-6">
            <a href={site.contact.phoneHref} class="whitespace-nowrap hover:text-black hover:underline">
              {site.contact.phone}
            </a>
            <br />
            <a href={`mailto:${site.contact.email}`} class="underline hover:text-black">
              {site.contact.email}
            </a>
          </p>
          <SocialLinks class="flex" />
        </div>
      </div>

      <!--
        Copyright, then the designer's credit as her design sets it, but in the
        55% grey of the other footer text: the design's 50% falls short of the
        4.5:1 contrast WCAG asks for on the sand ground.
      -->
      <p
        class="col-span-2 text-xs leading-[18px] tracking-[0.02em] lg:col-span-1 lg:col-start-1 lg:row-start-2"
      >
        &copy; {year} {t.brand.name}
        <span class="mx-1" aria-hidden="true">|</span>
        <a
          href="https://www.lidijajankovic.com"
          target="_blank"
          rel="noopener"
          class="text-black/55 underline transition-colors hover:text-black"
        >
          Made by Lidija Janković
        </a>
      </p>
    </div>
  </div>
</footer>
