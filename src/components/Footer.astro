---
import Icon from "./Icon.astro";
import logo from "../assets/logo-dcr-negative.svg";
import site from "../data/site.json";
import type { Locale } from "../i18n/config";
import { localizePath, useTranslations } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const year = new Date().getFullYear();

// A representative slice of the treatment catalogue for the footer.
const footerServices = t.services.groups.map((group) => group.title);
---

<footer class="bg-theme-brand text-theme-text-on-brand">
  <div class="container section-sm">
    <div class="grid gap-10 lg:grid-cols-3">
      <!-- Brand and contact -->
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <!-- Negative mark: the positive one is PANTONE 319 C itself and would
               vanish on this ground. The brand manual sanctions the negative
               for use on colour. -->
          <img
            src={logo.src}
            alt={t.brand.logoAlt}
            width="48"
            height="48"
            class="w-12 h-12"
            loading="lazy"
          />
          <span class="text-xl lg:text-2xl font-bold">
            {t.brand.name}
          </span>
        </div>

        <ul class="space-y-3 mb-6">
          <li class="flex items-start">
            <Icon name="location" size="sm" class="mt-1 mr-3 flex-shrink-0" />
            <p class="text-sm">
              {site.contact.addressLine1}<br />{site.contact.addressLine2}
            </p>
          </li>
          <li class="flex items-start">
            <Icon name="phone" size="sm" class="mt-1 mr-3 flex-shrink-0" />
            <p class="text-sm">
              <a href={site.contact.phoneHref} class="hover:underline">
                {site.contact.phone}
              </a>
              <span class="block">{t.common.callUsToday}</span>
            </p>
          </li>
          <li class="flex items-start">
            <Icon name="email" size="sm" class="mt-1 mr-3 flex-shrink-0" />
            <p class="text-sm">
              <a href={`mailto:${site.contact.email}`} class="hover:underline">
                {site.contact.email}
              </a>
            </p>
          </li>
        </ul>

        <p class="text-sm leading-relaxed max-w-xl">
          {t.footer.description}
        </p>
      </div>

      <!-- Services -->
      <div>
        <h2 class="text-base font-semibold mb-4">
          {t.footer.servicesHeading}
        </h2>
        <ul class="space-y-2">
          {
            footerServices.map((service) => (
              <li>
                <a
                  href={localizePath("/services", locale)}
                  class="text-sm hover:underline"
                >
                  {service}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-10 pt-6 border-t border-theme-text-on-brand/25 flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <p class="text-sm">
        &copy; {year} {t.brand.name}. {t.footer.rightsReserved}.
      </p>
      <nav class="flex flex-wrap justify-center gap-x-4 gap-y-2">
        {
          t.nav.links.map((link) => (
            <a
              href={localizePath(link.href, locale)}
              class="text-sm hover:underline"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
