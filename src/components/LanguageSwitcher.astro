---
/**
 * LanguageSwitcher - Links to the current page in every available language.
 *
 * Rendered as a row of flags on every breakpoint: one click or tap to switch,
 * with no dropdown to open. Plain anchors, so it works without JavaScript and
 * stays crawlable by search engines.
 *
 * Flags carry no visible text label: the header is tight at the lg breakpoint
 * with five nav links and a booking button, and language codes cost roughly
 * 100px. Each link still exposes the language name to assistive tech via
 * sr-only text, and as a title tooltip on hover.
 */
import { locales, localeNames, type Locale } from "../i18n/config";
import { getAlternateLinks, useTranslations } from "../i18n/utils";
import FlagIcon from "./FlagIcon.astro";

interface Props {
  locale: Locale;
  /**
   * - `default`: sizing for the wide header
   * - `compact`: tightened for the mobile header bar
   */
  variant?: "default" | "compact";
  class?: string;
}

const { locale, variant = "default", class: className = "" } = Astro.props;
const t = useTranslations(locale);

const alternates = getAlternateLinks(Astro.url.pathname);
const hrefFor = (target: Locale) =>
  alternates.find((alternate) => alternate.locale === target)?.path ?? "/";

const isCompact = variant === "compact";
---

<nav aria-label={t.nav.languageLabel} class={className}>
  <ul class:list={["flex items-center", isCompact ? "gap-0.5 xs:gap-1" : "gap-0.5"]}>
    {
      locales.map((option) => {
        const isActive = option === locale;
        return (
          <li>
            <a
              href={hrefFor(option)}
              hreflang={option}
              lang={option}
              aria-current={isActive ? "true" : undefined}
              title={localeNames[option]}
              class:list={[
                "flex items-center justify-center rounded-lg transition-colors duration-200",
                // 40px tall on mobile, comfortably above the WCAG 2.5.8 minimum.
                isCompact ? "h-10 w-9 xs:w-10" : "h-9 w-9",
                isActive
                  ? "bg-theme-primary/10 ring-1 ring-theme-primary-lighter"
                  : "hover:bg-theme-surface-hover",
              ]}
            >
              <FlagIcon
                locale={option}
                class:list={[
                  "h-auto rounded-sm ring-1 ring-black/10 transition-opacity duration-200 flex-shrink-0",
                  isCompact ? "w-6" : "w-5",
                  isActive ? "opacity-100" : "opacity-55 hover:opacity-100",
                ]}
              />
              <span class="sr-only">{localeNames[option]}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
