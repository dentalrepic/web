---
// Import the components from the astro-navbar npm package
import { Astronav, MenuItems } from "astro-navbar";
import Icon from "./Icon.astro";
import logo from "../assets/logo-dcr.svg";
import site from "../data/site.json";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import type { Locale } from "../i18n/config";
import { localizePath, stripLocaleFromPath, useTranslations } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const normalizePath = (path: string) =>
  path === "/" ? "/" : path.replace(/\/$/, "");

// Compare against the locale-stripped route so highlighting works in every language.
const currentPath = normalizePath(stripLocaleFromPath(Astro.url.pathname || "/"));
const isCurrentPage = (href: string) => {
  const target = normalizePath(href);
  if (target === "/") return currentPath === "/";
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---

<header
  class="sticky top-0 z-50 bg-theme-surface/98 backdrop-blur-lg supports-[backdrop-filter]:bg-theme-surface/95 border-b border-theme-border"
>
  <div class="container">
    <Astronav>
      <div class="flex items-center justify-between w-full py-4 xl:py-5">
        <!-- Logo -->
        <a
          href={localizePath("/", locale)}
          class="shrink-0 flex items-center gap-2.5 group relative z-10"
        >
          <!-- SVG monogram: served as a plain <img> so it stays crisp at any
               density, with no raster processing needed -->
          <img
            src={logo.src}
            alt={t.brand.logoAlt}
            width="44"
            height="44"
            class="w-10 h-10 xl:w-11 xl:h-11 rounded-xl transition-transform duration-300 group-hover:scale-[1.04]"
            loading="eager"
            fetchpriority="high"
          />
          <span
            class="hidden sm:inline text-lg xl:text-2xl font-display font-bold text-theme-primary whitespace-nowrap"
          >
            {t.brand.name}
          </span>
          <!-- Narrow phones: the logo alone stands in for the name -->
          <span class="sm:hidden sr-only">{t.brand.name}</span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden xl:flex items-center gap-1">
          <ul class="flex items-center gap-0.5">
            {
              t.nav.links.map((link) => (
                <li>
                  <a
                    class="nav-link whitespace-nowrap"
                    href={localizePath(link.href, locale)}
                    aria-current={isCurrentPage(link.href) ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>

          <!-- Language Switcher -->
          <LanguageSwitcher locale={locale} class="ml-1 xxl:ml-2" />

          <!-- Phone and booking CTA -->
          <div class="ml-2 pl-2 xxl:ml-3 xxl:pl-3 border-l border-theme-border flex items-center gap-3">
            <a
              href={site.contact.phoneHref}
              class="hidden xxl:flex items-center gap-2 text-sm font-semibold text-theme-primary hover:text-theme-primary-dark transition-colors whitespace-nowrap"
            >
              <Icon name="phone" size="sm" />
              <span>{site.contact.phone}</span>
            </a>
            <a
              class="button button-primary text-sm whitespace-nowrap"
              href={localizePath(t.nav.cta.href, locale)}
            >
              {t.nav.cta.label}
            </a>
          </div>
        </nav>

        <!--
          Mobile header controls: the language dropdown stays in the bar, so it
          is reachable without opening the main menu first.
        -->
        <div class="xl:hidden flex items-center gap-1">
          <LanguageSwitcher locale={locale} variant="compact" />

          <!--
            Mobile Menu Button

            Hand-rolled instead of astro-navbar's <MenuIcon />, whose aria-label and
            SVG title are hardcoded English. The `astronav-menu` id and
            `astronav-toggle` classes are what Astronav's script binds to, so the
            toggle behaviour is unchanged.
          -->
          <button id="astronav-menu" aria-label={t.nav.menuLabel} aria-expanded="false">
            <svg
              fill="currentColor"
              class="w-6 h-6 text-theme-text-secondary"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                class="astronav-close-icon astronav-toggle hidden"
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M18.278 16.864a1 1 0 01-1.414 1.414l-4.829-4.828-4.828 4.828a1 1 0 01-1.414-1.414l4.828-4.829-4.828-4.828a1 1 0 011.414-1.414l4.829 4.828 4.828-4.828a1 1 0 111.414 1.414l-4.828 4.829 4.828 4.828z"
              ></path>
              <path
                class="astronav-open-icon astronav-toggle"
                fill-rule="evenodd"
                d="M4 5h16a1 1 0 010 2H4a1 1 0 110-2zm0 6h16a1 1 0 010 2H4a1 1 0 010-2zm0 6h16a1 1 0 010 2H4a1 1 0 010-2z"
              ></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Menu -->
      <MenuItems class="hidden xl:hidden mobile-menu">
        <nav class="bg-theme-surface border-t border-theme-border shadow-md">
          <div class="max-w-md mx-auto px-4 py-6">
            <ul class="space-y-1 mb-6">
              {
                t.nav.links.map((link) => (
                  <li>
                    <a
                      class="mobile-nav-link group flex items-center px-4 py-3 text-base font-medium text-theme-text-secondary hover:text-theme-primary hover:bg-theme-surface-hover transition-colors duration-200 rounded-xl"
                      href={localizePath(link.href, locale)}
                      aria-current={isCurrentPage(link.href) ? "page" : undefined}
                    >
                      <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-theme-surface-muted group-hover:bg-theme-surface-hover transition-colors mr-3 flex items-center justify-center">
                        <Icon
                          name={link.icon as any}
                          size="md"
                          class="text-theme-text-secondary group-hover:text-theme-primary transition-colors"
                        />
                      </div>
                      <span>{link.label}</span>
                    </a>
                  </li>
                ))
              }
            </ul>

            <!-- CTA Button -->
            <div class="pt-4 border-t border-theme-border space-y-3">
              <a
                class="button button-primary w-full justify-center text-base"
                href={localizePath(t.nav.cta.href, locale)}
              >
                {t.nav.cta.label}
              </a>
              <a
                href={site.contact.phoneHref}
                class="flex items-center justify-center gap-2 py-2 text-base font-semibold text-theme-primary hover:text-theme-primary-dark transition-colors"
              >
                <Icon name="phone" size="sm" />
                <span>{site.contact.phone}</span>
              </a>
            </div>
          </div>
        </nav>
      </MenuItems>
    </Astronav>
  </div>
</header>

<style>
  .mobile-menu {
    animation: slideDown 0.3s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-nav-link:active {
    transform: scale(0.98);
  }

  /* Active link highlighting */
  .nav-link[aria-current="page"],
  .mobile-nav-link[aria-current="page"] {
    color: var(--color-theme-primary);
    background-color: var(--color-theme-surface-hover);
  }

  /* Mobile menu button styling */
  #astronav-menu {
    padding: 0.5rem;
    margin-right: -0.5rem;
    border-radius: 0.5rem;
    transition: background-color 150ms ease;
  }

  #astronav-menu:hover {
    background-color: var(--color-theme-surface-hover);
  }
</style>
