---
// Import the components from the astro-navbar npm package
import { Astronav, MenuItems } from "astro-navbar";
import Icon from "./Icon.astro";
import logo from "../assets/logo-dcr-lockup-white.svg";
import site from "../data/site.json";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import type { Locale } from "../i18n/config";
import { localizePath, stripLocaleFromPath, useTranslations } from "../i18n/utils";

interface Props {
  locale: Locale;
  /**
   * Float the header over the page's photo hero with a light tint, turning
   * solid once the page scrolls. Without it the header is solid from the
   * start, for pages that do not open with a photo.
   */
  overlay?: boolean;
}

const { locale, overlay = false } = Astro.props;
const t = useTranslations(locale);

const normalizePath = (path: string) =>
  path === "/" ? "/" : path.replace(/\/$/, "");

// Compare against the locale-stripped route so highlighting works in every language.
const currentPath = normalizePath(stripLocaleFromPath(Astro.url.pathname || "/"));
const isCurrentPage = (href: string) => {
  const target = normalizePath(href);
  if (target === "/") return currentPath === "/";
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---

<header
  class:list={["site-header top-0 inset-x-0 z-50", overlay ? "fixed" : "sticky"]}
  data-overlay={overlay ? "true" : undefined}
  data-solid={overlay ? undefined : "true"}
>
  <div class="container">
    <Astronav>
      <div class="flex h-20 items-center justify-between w-full">
        <!-- Logo -->
        <a
          href={localizePath("/", locale)}
          class="shrink-0 flex items-center group relative z-10"
        >
          <!--
            The manual's primary logo ("odnos logotipa i znaka", page 11) in
            white, as the header always sits on a photo or on the brown ground.
          -->
          <img
            src={logo.src}
            alt={t.brand.logoAlt}
            width="85"
            height="36"
            class="h-9 w-auto"
            loading="eager"
            fetchpriority="high"
          />
          <span class="sr-only">{t.brand.name}</span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden lg:flex items-center gap-8">
          <ul class="flex items-center gap-8">
            {
              t.nav.links.map((link) => (
                <li>
                  <a
                    class="nav-link whitespace-nowrap"
                    href={localizePath(link.href, locale)}
                    aria-current={isCurrentPage(link.href) ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>

          <LanguageSwitcher locale={locale} tone="dark" />
        </nav>

        <a
          class="header-cta hidden lg:inline-flex items-center rounded px-3 py-1.5 text-sm leading-6 whitespace-nowrap transition-colors"
          href={localizePath(t.nav.cta.href, locale)}
        >
          {t.nav.cta.label}
        </a>

        <!--
          Mobile header controls: the language dropdown stays in the bar, so it
          is reachable without opening the main menu first.
        -->
        <div class="lg:hidden flex items-center gap-1">
          <LanguageSwitcher locale={locale} variant="compact" tone="dark" />

          <!--
            Mobile Menu Button

            Hand-rolled instead of astro-navbar's <MenuIcon />, whose aria-label and
            SVG title are hardcoded English. The `astronav-menu` id and
            `astronav-toggle` classes are what Astronav's script binds to, so the
            toggle behaviour is unchanged.
          -->
          <button id="astronav-menu" aria-label={t.nav.menuLabel} aria-expanded="false">
            <svg
              fill="currentColor"
              class="w-6 h-6 text-white"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                class="astronav-close-icon astronav-toggle hidden"
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M18.278 16.864a1 1 0 01-1.414 1.414l-4.829-4.828-4.828 4.828a1 1 0 01-1.414-1.414l4.828-4.829-4.828-4.828a1 1 0 011.414-1.414l4.829 4.828 4.828-4.828a1 1 0 111.414 1.414l-4.828 4.829 4.828 4.828z"
              ></path>
              <path
                class="astronav-open-icon astronav-toggle"
                fill-rule="evenodd"
                d="M4 5h16a1 1 0 010 2H4a1 1 0 110-2zm0 6h16a1 1 0 010 2H4a1 1 0 010-2zm0 6h16a1 1 0 010 2H4a1 1 0 010-2z"
              ></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Menu -->
      <MenuItems class="hidden lg:hidden mobile-menu">
        <nav class="bg-theme-surface rounded shadow-md mb-4">
          <div class="max-w-md mx-auto px-4 py-6">
            <ul class="space-y-1 mb-6">
              {
                t.nav.links.map((link) => (
                  <li>
                    <a
                      class="mobile-nav-link group flex items-center px-4 py-3 text-base text-theme-ink hover:bg-theme-surface-warm transition-colors duration-200 rounded"
                      href={localizePath(link.href, locale)}
                      aria-current={isCurrentPage(link.href) ? "page" : undefined}
                    >
                      <span>{link.label}</span>
                    </a>
                  </li>
                ))
              }
            </ul>

            <!-- CTA Button -->
            <div class="pt-4 border-t border-theme-border space-y-3">
              <a
                class="button button-ink w-full justify-center"
                href={localizePath(t.nav.cta.href, locale)}
              >
                {t.nav.cta.label}
              </a>
              <a
                href={site.contact.phoneHref}
                class="flex items-center justify-center gap-2 py-2 text-base text-theme-ink hover:underline"
              >
                <Icon name="phone" size="sm" />
                <span>{site.contact.phone}</span>
              </a>
            </div>
          </div>
        </nav>
      </MenuItems>
    </Astronav>
  </div>
</header>

<script>
  /**
   * The overlay header turns solid once the page has scrolled, so its white
   * links stay legible over the light sections below the hero. It is also
   * solid while the mobile menu is open.
   */
  function setupHeader() {
    const header = document.querySelector<HTMLElement>(".site-header[data-overlay]");
    if (!header) return;

    const menuButton = document.getElementById("astronav-menu");
    const update = () => {
      const scrolled = window.scrollY > 24;
      const menuOpen = menuButton?.getAttribute("aria-expanded") === "true";
      header.toggleAttribute("data-solid", scrolled || menuOpen);
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
    menuButton?.addEventListener("click", () => requestAnimationFrame(update));
    document.addEventListener(
      "astro:before-swap",
      () => window.removeEventListener("scroll", update),
      { once: true }
    );
  }

  setupHeader();
  document.addEventListener("astro:page-load", setupHeader);
</script>

<style>
  .site-header {
    background-color: var(--color-theme-ink);
    transition: background-color 200ms ease;
  }

  /* Over the hero photo: the design's 20% brown tint */
  .site-header[data-overlay]:not([data-solid]) {
    background-color: rgb(71 68 66 / 0.2);
  }

  /* Brown button over the photo; white once the header itself is brown */
  .header-cta {
    color: #ffffff;
    background-color: var(--color-theme-ink);
  }

  .site-header[data-solid] .header-cta {
    color: var(--color-theme-ink);
    background-color: #ffffff;
  }

  .header-cta:hover {
    background-color: #2f2d2c;
  }

  .site-header[data-solid] .header-cta:hover {
    background-color: var(--color-theme-sand);
  }

  .mobile-menu {
    animation: slideDown 0.3s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-nav-link:active {
    transform: scale(0.98);
  }

  /* Active link highlighting */
  .mobile-nav-link[aria-current="page"] {
    background-color: var(--color-theme-surface-warm);
    font-weight: 500;
  }

  /* Mobile menu button styling */
  #astronav-menu {
    padding: 0.5rem;
    margin-right: -0.5rem;
    border-radius: 4px;
    transition: background-color 150ms ease;
  }

  #astronav-menu:hover {
    background-color: rgb(255 255 255 / 0.15);
  }
</style>
