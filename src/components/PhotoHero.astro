---
/**
 * Full-width photo hero: a small label and a large serif title in white,
 * optionally followed by a lead paragraph and buttons (the `default` slot).
 *
 * The header overlays the top 80px of the photo (see Layout's `overlayNav`),
 * so the photo runs to the top of the page. The design's photos carry their
 * own wash behind the text from tablet width up; on phones see `stacked`.
 */
import { Image } from "astro:assets";

interface Props {
  eyebrow: string;
  title: string;
  /** Lead paragraph under the title, in the brown ink. */
  lead?: string;
  /** Decorative backdrop: the title carries the meaning, so it has no alt text. */
  image: ImageMetadata;
  /** CSS object-position, to keep the subject in frame on narrow screens. */
  focus?: string;
  /**
   * Colour of the small label: `ink` (brown) on photos with a pale wash,
   * `white` on darker ones.
   */
  eyebrowTone?: "ink" | "white";
  /** `center` for a hero with a lead and buttons, `end` for a title alone. */
  align?: "center" | "end";
}

const {
  eyebrow,
  title,
  lead,
  image,
  focus = "center",
  eyebrowTone = "white",
  align = "end",
} = Astro.props;

/*
 * On phones the cover crop drops the pale wash the text sits on and puts it
 * over the subject instead. A title alone at the bottom gets a bottom-up
 * shade; a centred hero, with its brown lead and buttons, is stacked: the
 * photo on top, the text below it on sand.
 */
const stacked = align === "center";
---

<section
  class:list={[
    "relative isolate overflow-hidden",
    stacked ? "bg-theme-sand md:bg-theme-ink" : "bg-theme-ink",
  ]}
>
  <Image
    src={image}
    alt=""
    widths={[640, 960, 1280, 1920, 2560]}
    sizes="100vw"
    class:list={[
      "-z-10 w-full object-cover",
      stacked
        ? "relative h-[360px] sm:h-[440px] md:absolute md:inset-0 md:h-full"
        : "absolute inset-0 h-full",
    ]}
    style={`object-position: ${focus}`}
    loading="eager"
    fetchpriority="high"
  />
  {
    !stacked && (
      <div
        class="absolute inset-x-0 bottom-0 -z-10 h-3/4 bg-linear-to-t from-black/65 via-black/30 to-transparent md:hidden"
        aria-hidden="true"
      />
    )
  }

  <div
    class:list={[
      "container flex md:min-h-[540px] lg:min-h-[616px]",
      stacked
        ? "pb-12 pt-10 md:items-center md:pb-14 md:pt-32 lg:pb-20"
        : "min-h-[460px] items-end pb-14 pt-32 lg:pb-24",
    ]}
  >
    <div class="max-w-[500px]">
      <p
        class:list={[
          "eyebrow mb-2",
          eyebrowTone === "white"
            ? "text-white"
            : stacked
              ? "text-theme-ink"
              : "text-white md:text-theme-ink",
        ]}
      >
        {eyebrow}
      </p>
      <h1
        class:list={[
          "font-serif text-[2.5rem] font-semibold leading-[1.15] tracking-normal sm:text-5xl lg:text-6xl",
          stacked ? "text-theme-ink md:text-white" : "text-white",
        ]}
      >
        {title}
      </h1>
      {
        lead && (
          <p class="mt-8 text-base leading-7 tracking-[0.02em] text-theme-ink lg:mt-12">
            {lead}
          </p>
        )
      }
      {
        Astro.slots.has("default") && (
          <div class="mt-8 flex flex-wrap gap-4 sm:gap-6">
            <slot />
          </div>
        )
      }
    </div>
  </div>
</section>
