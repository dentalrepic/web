---
/**
 * Full-width photo hero: a small label and a large serif title in white,
 * optionally followed by a lead paragraph and buttons (the `default` slot).
 *
 * The header overlays the top 80px of the photo (see Layout's `overlayNav`),
 * so the photo runs to the top of the page. The design's photos carry their
 * own wash behind the text from tablet width up; on phones the text sits
 * below the photo instead.
 */
import { Image } from "astro:assets";

interface Props {
  eyebrow: string;
  title: string;
  /** Lead paragraph under the title, in the brown ink. */
  lead?: string;
  /** Decorative backdrop: the title carries the meaning, so it has no alt text. */
  image: ImageMetadata;
  /** CSS object-position, to keep the subject in frame on narrow screens. */
  focus?: string;
  /**
   * Colour of the small label: `ink` (brown) on photos with a pale wash,
   * `white` on darker ones.
   */
  eyebrowTone?: "ink" | "white";
  /** `center` for a hero with a lead and buttons, `end` for a title alone. */
  align?: "center" | "end";
  /** Darken the left of the photo behind the text, for a pale backdrop (md up). */
  shade?: boolean;
}

const {
  eyebrow,
  title,
  lead,
  image,
  focus = "center",
  eyebrowTone = "white",
  align = "end",
  shade = false,
} = Astro.props;

/*
 * On phones the cover crop drops the pale wash the text sits on and puts it
 * over the subject instead, so every hero is stacked there: the photo on
 * top, the text below it on sand in ink. From md the text sits on the photo.
 */
const centred = align === "center";
// One sentence per line: "A modern approach." / "A healthy smile.", plus any
// break written into the copy as "\n" ("People you\ncan trust."). From md a
// title with several lines keeps each one whole, even past the 500px column;
// a single line still wraps within it as designed.
const titleLines = title.split(/\n|(?<=\.)\s+/);
const keepWhole = titleLines.length > 1;
---

<section class="relative isolate overflow-hidden bg-theme-sand md:bg-theme-ink">
  <Image
    src={image}
    alt=""
    widths={[640, 960, 1280, 1920, 2560]}
    sizes="100vw"
    class="relative -z-10 h-[360px] w-full object-cover md:absolute md:inset-0 md:h-full"
    style={`object-position: ${focus}`}
    loading="eager"
    fetchpriority="high"
  />
  {
    shade && (
      <div
        class="absolute inset-0 -z-10 hidden bg-linear-to-r from-black/45 via-black/20 to-transparent md:block"
        aria-hidden="true"
      />
    )
  }

  <div
    class:list={[
      "container flex pb-12 pt-10 md:min-h-[540px] md:pb-14 md:pt-32 lg:min-h-[616px]",
      centred ? "md:items-center lg:pb-20" : "md:items-end lg:pb-24",
    ]}
  >
    <div class="max-w-[500px]">
      <p
        class:list={[
          "eyebrow mb-2 text-theme-ink",
          eyebrowTone === "white" && "md:text-white",
        ]}
      >
        {eyebrow}
      </p>
      <h1 class="font-serif text-[2.25rem] font-semibold leading-[1.15] tracking-normal text-theme-ink sm:text-5xl md:text-white lg:text-6xl">
        {
          titleLines.map((line, index) => (
            <>
              {index > 0 && <br />}
              <span class:list={[keepWhole && "md:whitespace-nowrap"]}>{line}</span>
            </>
          ))
        }
      </h1>
      {
        lead && (
          <p class="mt-8 text-base leading-7 tracking-[0.02em] text-theme-ink lg:mt-12">
            {lead}
          </p>
        )
      }
      {
        Astro.slots.has("default") && (
          <div class="mt-8 flex flex-wrap gap-4 sm:gap-6">
            <slot />
          </div>
        )
      }
    </div>
  </div>
</section>
