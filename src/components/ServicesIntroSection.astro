---
import implantsImage from "../assets/professional-care.jpg";
import orthodonticsImage from "../assets/service-detail.jpg";
import aestheticImage from "../assets/about-main.jpg";
import Card from "./Card.astro";
import type { Locale } from "../i18n/config";
import { localizePath, useTranslations } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Images pair positionally with the translated service summaries.
const images = [implantsImage, orthodonticsImage, aestheticImage];

const services = t.home.servicesIntro.services.map((service, index) => ({
  ...service,
  image: images[index],
  link: localizePath("/services", locale),
}));
---

<div class="container">
  <div class="narrow mx-auto text-center mb-12">
    <p class="text-sm font-medium tracking-widest uppercase text-theme-primary mb-4">
      {t.home.servicesIntro.eyebrow}
    </p>
    <h2 class="mb-4">{t.home.servicesIntro.heading}</h2>
    <p class="text-base lg:text-lg text-theme-text-secondary">
      {t.home.servicesIntro.description}
    </p>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
    {
      services.map((service) => (
        <Card
          title={service.title}
          summary={service.summary}
          image={service.image}
          link={service.link}
          ctaLabel={t.common.learnMore}
        />
      ))
    }
  </div>
</div>
