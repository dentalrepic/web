---
import infusionImage from "../assets/professional-staff.jpg";
import patientCareImage from "../assets/about-main.jpg";
import staffImage from "../assets/team-professionals.jpg";
import Card from "./Card.astro";
import type { Locale } from "../i18n/config";
import { localizePath, useTranslations } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Images and anchors are locale-independent; titles and summaries are translated.
const images = [infusionImage, patientCareImage, staffImage];
const anchors = [
  "/services#professional-healthcare-services",
  "/services#our-patient-care",
  "/services#our-staff",
];

const services = t.home.servicesIntro.services.map((service, index) => ({
  ...service,
  image: images[index],
  link: localizePath(anchors[index], locale),
}));
---

<div class="container">
  <div class="text-center mb-12">
    <p class="text-sm font-medium tracking-widest uppercase text-theme-primary mb-4">
      {t.home.servicesIntro.eyebrow}
    </p>
    <h2>{t.home.servicesIntro.heading}</h2>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
    {
      services.map((service) => (
        <Card
          title={service.title}
          summary={service.summary}
          image={service.image}
          link={service.link}
          ctaLabel={t.common.learnMore}
        />
      ))
    }
  </div>
</div>
