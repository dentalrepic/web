---
/**
 * About page body. Rendered by the localized route files.
 *
 * Layout follows the "O nama" design: a full-width team photo, a short
 * introduction, a portrait grid of the staff, patient reviews, then the
 * booking band.
 */
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import PhotoHero from "../PhotoHero.astro";
import SectionIntro from "../SectionIntro.astro";
import BookingBand from "../BookingBand.astro";
import heroImage from "../../assets/team/team-hero.jpg";
import member1 from "../../assets/team/member-1.jpg";
import member2 from "../../assets/team/member-2.jpg";
import member3 from "../../assets/team/member-3.jpg";
import member4 from "../../assets/team/member-4.jpg";
import member6 from "../../assets/team/member-6.jpg";
import member7 from "../../assets/team/member-7.jpg";
import member8 from "../../assets/team/member-8.jpg";
import member9 from "../../assets/team/member-9.jpg";
import type { Locale } from "../../i18n/config";
import { useTranslations } from "../../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const about = t.about;

// Portraits pair positionally with about.team in the translations.
const portraits = [member1, member2, member3, member4, member6, member7, member8, member9];

const team = about.team.map((member, index) => ({
  ...member,
  portrait: portraits[index],
}));
---

<Layout locale={locale} title={about.meta.title} description={about.meta.description} overlayNav>
  <PhotoHero
    eyebrow={about.hero.eyebrow}
    title={about.hero.title}
    image={heroImage}
    focus="74% center"
  />

  <SectionIntro
    eyebrow={about.intro.eyebrow}
    heading={about.intro.heading}
    paragraph={about.intro.paragraph}
  />

  <!-- Team -->
  <section class="section bg-theme-surface">
    <div class="container">
      <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-14">
        {
          team.map((member) => (
            <li>
              {member.portrait && (
                <Image
                  src={member.portrait}
                  alt={member.name}
                  widths={[400, 600, 800]}
                  sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
                  class="mb-5 aspect-[7/8] w-full rounded-md object-cover"
                  loading="lazy"
                />
              )}
              <h2 class="mb-1 text-base font-medium leading-snug tracking-normal text-theme-text-primary">
                {member.name}
              </h2>
              <p class="text-sm leading-relaxed text-theme-text-muted">{member.role}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Patient reviews ("Iskustva pacijenata") -->
  <section class="bg-theme-surface-warm py-12 lg:py-16">
    <div class="container flex flex-col gap-10">
      <div class="mx-auto flex max-w-[1000px] flex-col gap-4 text-center">
        <h2 class="font-serif text-3xl font-medium leading-tight tracking-normal text-black lg:text-4xl">
          {about.reviews.heading}
        </h2>
        <p class="text-base leading-7 tracking-[0.02em] text-black">
          {
            about.reviews.intro.map((line, index) => (
              <>
                {index > 0 && <br />}
                {line}
              </>
            ))
          }
        </p>
      </div>
      <ul class="grid gap-6 md:grid-cols-3">
        {
          about.reviews.items.map((review) => (
            <li>
              <figure class="flex h-full flex-col gap-6 rounded bg-theme-surface p-6 lg:p-8">
                <figcaption class="text-base leading-7 tracking-[0.02em] text-black">
                  {review.name}
                </figcaption>
                <blockquote class="text-base leading-7 tracking-[0.02em] text-black/55">
                  <p>{review.text}</p>
                </blockquote>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <BookingBand locale={locale} />
</Layout>
