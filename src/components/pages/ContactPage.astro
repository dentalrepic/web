---
/**
 * Contact page body. Rendered by the localized route files.
 *
 * The form is a front-end demo only: submissions are not sent anywhere. Connect
 * a form provider before using this in production.
 */
import Layout from "../../layouts/Layout.astro";
import PageHero from "../PageHero.astro";
import contactImage from "../../assets/contact-image.jpg";
import site from "../../data/site.json";
import type { Locale } from "../../i18n/config";
import { useTranslations } from "../../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const contact = t.contact;
---

<Layout locale={locale} title={contact.meta.title} description={contact.meta.description}>
  <PageHero
    title={contact.hero.title}
    description={contact.hero.description}
    image={contactImage}
  />

  <section
    class="section bg-gradient-to-b from-theme-surface-muted to-theme-surface"
    id="contact"
  >
    <div class="container">
      <div class="flex items-stretch justify-center">
        <div class="grid md:grid-cols-2">
          <div class="h-full mt-3 mb-12 pr-6">
            <p class="mt-3 mb-12 text-lg text-theme-text-primary">
              {contact.intro}
            </p>
            <ul class="mb-6 md:mb-0">
              <li class="flex">
                <div class="flex h-10 w-10 items-center justify-center">
                  <svg
                    class="w-6 h-6 text-theme-primary"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                      clip-rule="evenodd"></path>
                  </svg>
                </div>
                <div class="ml-4 mb-4">
                  <h3
                    class="mb-2 text-lg font-medium leading-6 text-theme-text-primary"
                  >
                    {contact.addressHeading}
                  </h3>
                  <p class="text-theme-text-primary">{site.contact.addressLine1}</p>
                  <p class="text-theme-text-primary">{site.contact.addressLine2}</p>
                </div>
              </li>
              <li class="flex">
                <div class="flex h-10 w-10 items-center justify-center">
                  <svg
                    class="w-6 h-6 text-theme-primary"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
                    ></path>
                    <path
                      d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
                    ></path>
                  </svg>
                </div>
                <div class="ml-4 mb-4">
                  <h3
                    class="mb-2 text-lg font-medium leading-6 text-theme-text-primary"
                  >
                    {contact.contactHeading}
                  </h3>
                  <p class="text-theme-text-primary">
                    {contact.phoneLabel}: {site.contact.phone}
                  </p>
                  <p class="text-theme-text-primary">
                    {contact.emailLabel}: {site.contact.email}
                  </p>
                </div>
              </li>
              <li class="flex">
                <div class="flex h-10 w-10 items-center justify-center">
                  <svg
                    class="w-6 h-6 text-theme-primary"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z"
                      clip-rule="evenodd"></path>
                  </svg>
                </div>
                <div class="ml-4 mb-4">
                  <h3
                    class="mb-2 text-lg font-medium leading-6 text-theme-text-primary"
                  >
                    {t.common.workingHours.heading}
                  </h3>
                  <p class="text-theme-text-primary">{t.common.workingHours.weekdays}</p>
                  <p class="text-theme-text-primary">{t.common.workingHours.saturday}</p>
                  <p class="text-theme-text-primary">{t.common.workingHours.sunday}</p>
                </div>
              </li>
            </ul>
          </div>
          <div
            class="bg-theme-surface rounded-2xl shadow-xl p-8 md:p-10 h-full border border-theme-border hover:shadow-2xl transition-shadow duration-300"
            id="form"
          >
            <h2 class="mb-6 text-2xl font-bold text-theme-text-primary">
              {contact.form.heading}
            </h2>
            <form id="contactForm">
              <div class="mb-6">
                <div class="mx-0 mb-1 sm:mb-4">
                  <div class="mx-0 mb-1 sm:mb-4">
                    <label
                      for="name"
                      class="block pb-2 text-xs font-semibold uppercase tracking-wider text-theme-text-primary"
                      >{contact.form.nameLabel}</label
                    ><input
                      type="text"
                      id="name"
                      autocomplete="given-name"
                      placeholder={contact.form.namePlaceholder}
                      class="mb-2 w-full rounded-lg bg-theme-surface ring-1 ring-theme-border focus:ring-2 focus:ring-theme-primary focus:outline-none py-3 pl-4 pr-4 text-theme-text-primary sm:mb-0 transition-all duration-200"
                      name="name"
                      required
                    />
                  </div>
                  <div class="mx-0 mb-1 sm:mb-4">
                    <label
                      for="email"
                      class="block pb-2 text-xs font-semibold uppercase tracking-wider text-theme-text-primary"
                      >{contact.form.emailLabel}</label
                    ><input
                      type="email"
                      id="email"
                      autocomplete="email"
                      placeholder={contact.form.emailPlaceholder}
                      class="mb-2 w-full rounded-lg bg-theme-surface ring-1 ring-theme-border focus:ring-2 focus:ring-theme-primary focus:outline-none py-3 pl-4 pr-4 text-theme-text-primary sm:mb-0 transition-all duration-200"
                      name="email"
                      required
                    />
                  </div>
                </div>
                <div class="mx-0 mb-1 sm:mb-4">
                  <label
                    for="message"
                    class="block pb-2 text-xs font-semibold uppercase tracking-wider text-theme-text-primary"
                    >{contact.form.messageLabel}</label
                  ><textarea
                    id="message"
                    name="message"
                    cols="30"
                    rows="5"
                    placeholder={contact.form.messagePlaceholder}
                    required
                    class="mb-2 w-full rounded-lg bg-theme-surface ring-1 ring-theme-border focus:ring-2 focus:ring-theme-primary focus:outline-none py-3 pl-4 pr-4 text-theme-text-primary sm:mb-0 transition-all duration-200"
                  ></textarea>
                </div>
              </div>
              <div class="text-center">
                <button
                  type="submit"
                  class="w-full bg-theme-primary hover:bg-theme-primary-dark text-white px-6 py-3 text-lg font-semibold rounded-lg sm:mb-0 transition-all duration-300 hover:shadow-lg"
                  >{contact.form.submit}</button
                >
              </div>
              <p class="mt-4 text-sm text-theme-text-muted">
                {contact.form.demoNote}
              </p>
              <p
                id="contactFormStatus"
                class="mt-3 text-sm font-medium text-theme-primary"
                role="status"
                aria-live="polite"
                data-status-message={contact.form.statusMessage}
              >
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-theme-surface">
    <div class="container">
      <div class="block w-full shrink-0 grow-0 basis-auto lg:flex">
        <div class="h-[400px] w-full rounded-2xl overflow-hidden shadow-xl">
          <iframe
            src={site.mapEmbedUrl}
            title={contact.mapTitle}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="left-0 top-0 h-full w-full"
            style="border: 0;"
            allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupDemoContactForm() {
    const form = document.getElementById("contactForm") as HTMLFormElement | null;
    const status = document.getElementById("contactFormStatus");
    if (!form || !status || form.dataset.bound === "true") return;

    form.dataset.bound = "true";
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      // Message text is provided per locale via a data attribute.
      status.textContent = status.dataset.statusMessage ?? "";
    });
  }

  setupDemoContactForm();
  document.addEventListener("astro:page-load", setupDemoContactForm);
</script>
