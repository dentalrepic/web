---
/**
 * Contact page body. Rendered by the localized route files.
 *
 * The form is a front-end demo only: submissions are not sent anywhere. Connect
 * a form provider before using this in production.
 */
import Layout from "../../layouts/Layout.astro";
import PageHero from "../PageHero.astro";
import contactImage from "../../assets/contact-image.jpg";
import Icon from "../Icon.astro";
import site from "../../data/site.json";
import type { Locale } from "../../i18n/config";
import { useTranslations } from "../../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const contact = t.contact;
---

<Layout locale={locale} title={contact.meta.title} description={contact.meta.description}>
  <PageHero
    title={contact.hero.title}
    description={contact.hero.description}
    image={contactImage}
  />

  <section
    class="section bg-gradient-to-b from-theme-surface-muted to-theme-surface"
    id="contact"
  >
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <!-- Details -->
        <div>
          <p class="mb-8 text-lg text-theme-text-secondary">{contact.intro}</p>

          <ul class="space-y-6 mb-8">
            <li class="flex">
              <div class="flex h-10 w-10 items-center justify-center flex-shrink-0">
                <Icon name="location" size="md" class="text-theme-primary" />
              </div>
              <div class="ml-4">
                <h2 class="mb-2 text-lg font-semibold text-theme-text-primary">
                  {contact.addressHeading}
                </h2>
                <p class="text-theme-text-secondary">
                  {site.brandName}<br />
                  {site.contact.addressLine1}<br />
                  {site.contact.addressLine2}<br />
                  {site.contact.country}
                </p>
              </div>
            </li>
            <li class="flex">
              <div class="flex h-10 w-10 items-center justify-center flex-shrink-0">
                <Icon name="phone" size="md" class="text-theme-primary" />
              </div>
              <div class="ml-4">
                <h2 class="mb-2 text-lg font-semibold text-theme-text-primary">
                  {contact.contactHeading}
                </h2>
                <p class="text-theme-text-secondary">
                  {contact.phoneLabel}:{" "}
                  <a
                    href={site.contact.phoneHref}
                    class="font-semibold text-theme-primary hover:text-theme-primary-dark"
                  >
                    {site.contact.phone}
                  </a>
                </p>
                <p class="text-theme-text-secondary">
                  {contact.emailLabel}:{" "}
                  <a
                    href={`mailto:${site.contact.email}`}
                    class="font-semibold text-theme-primary hover:text-theme-primary-dark break-all"
                  >
                    {site.contact.email}
                  </a>
                </p>
              </div>
            </li>
            <li class="flex">
              <div class="flex h-10 w-10 items-center justify-center flex-shrink-0">
                <Icon name="book" size="md" class="text-theme-primary" />
              </div>
              <div class="ml-4 w-full">
                <h2 class="mb-2 text-lg font-semibold text-theme-text-primary">
                  {t.common.openingHours}
                </h2>
                <dl class="max-w-xs">
                  {
                    t.common.openingHoursRows.map((row) => (
                      <div class="flex justify-between gap-4 py-0.5">
                        <dt class="text-theme-text-secondary">{row.day}</dt>
                        <dd class="text-theme-text-primary font-medium whitespace-nowrap">
                          {row.hours}
                        </dd>
                      </div>
                    ))
                  }
                </dl>
              </div>
            </li>
          </ul>

          <p
            class="rounded-xl border border-theme-primary-lighter/50 bg-theme-primary-lighter/10 p-4 text-sm text-theme-primary-darker"
          >
            {contact.urgentNotice}
          </p>
        </div>

        <!-- Booking form -->
        <div
          class="bg-theme-surface rounded-2xl shadow-xl p-8 md:p-10 border border-theme-border"
          id="form"
        >
          <h2 class="mb-2 text-2xl font-bold text-theme-text-primary">
            {contact.form.heading}
          </h2>
          <p class="mb-6 text-sm text-theme-text-secondary">
            {contact.form.description}
          </p>

          <form id="contactForm" novalidate>
            <div class="space-y-4">
              <div>
                <label
                  for="name"
                  class="block pb-2 text-xs font-semibold uppercase tracking-wider text-theme-text-primary"
                  >{contact.form.nameLabel}</label
                >
                <input
                  type="text"
                  id="name"
                  name="name"
                  autocomplete="name"
                  placeholder={contact.form.namePlaceholder}
                  required
                />
              </div>

              <div>
                <label
                  for="email"
                  class="block pb-2 text-xs font-semibold uppercase tracking-wider text-theme-text-primary"
                  >{contact.form.emailLabel}</label
                >
                <input
                  type="email"
                  id="email"
                  name="email"
                  autocomplete="email"
                  placeholder={contact.form.emailPlaceholder}
                  required
                />
              </div>

              <div>
                <label
                  for="phone"
                  class="block pb-2 text-xs font-semibold uppercase tracking-wider text-theme-text-primary"
                  >{contact.form.phoneLabel}</label
                >
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  autocomplete="tel"
                  placeholder={contact.form.phonePlaceholder}
                />
              </div>

              <div>
                <label
                  for="reason"
                  class="block pb-2 text-xs font-semibold uppercase tracking-wider text-theme-text-primary"
                  >{contact.form.reasonLabel}</label
                >
                <select id="reason" name="reason">
                  {
                    contact.form.reasonOptions.map((option) => (
                      <option value={option}>{option}</option>
                    ))
                  }
                </select>
              </div>

              <div>
                <label
                  for="preferredTime"
                  class="block pb-2 text-xs font-semibold uppercase tracking-wider text-theme-text-primary"
                  >{contact.form.preferredTimeLabel}</label
                >
                <select id="preferredTime" name="preferredTime">
                  {
                    contact.form.preferredTimeOptions.map((option) => (
                      <option value={option}>{option}</option>
                    ))
                  }
                </select>
              </div>

              <div>
                <label
                  for="message"
                  class="block pb-2 text-xs font-semibold uppercase tracking-wider text-theme-text-primary"
                  >{contact.form.messageLabel}</label
                >
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  placeholder={contact.form.messagePlaceholder}></textarea>
              </div>
            </div>

            <button
              type="submit"
              class="button button-primary w-full justify-center mt-6"
              >{contact.form.submit}</button
            >

            <p class="mt-4 text-sm text-theme-text-muted">{contact.form.demoNote}</p>
            <p
              id="contactFormStatus"
              class="mt-3 text-sm font-medium text-theme-primary"
              role="status"
              aria-live="polite"
              data-status-message={contact.form.statusMessage}
            >
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="section-sm bg-theme-surface">
    <div class="container">
      <div class="h-[400px] w-full rounded-2xl overflow-hidden shadow-xl">
        <iframe
          src={site.mapEmbedUrl}
          title={contact.mapTitle}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="h-full w-full"
          style="border: 0;"
          allowfullscreen></iframe>
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupDemoContactForm() {
    const form = document.getElementById("contactForm") as HTMLFormElement | null;
    const status = document.getElementById("contactFormStatus");
    if (!form || !status || form.dataset.bound === "true") return;

    form.dataset.bound = "true";
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      // novalidate is set so we can trigger native messages ourselves.
      if (!form.reportValidity()) return;
      // Message text is provided per locale via a data attribute.
      status.textContent = status.dataset.statusMessage ?? "";
    });
  }

  setupDemoContactForm();
  document.addEventListener("astro:page-load", setupDemoContactForm);
</script>
