---
/**
 * Contact page body. Rendered by the localized route files.
 *
 * The booking form posts to /api/contact, a Cloudflare Pages Function in
 * functions/api/contact.ts. The form carries a real method and action, so it
 * still submits if JavaScript is unavailable.
 *
 * Spam protection: a honeypot field, plus a Cloudflare Turnstile "verify you
 * are human" check when PUBLIC_TURNSTILE_SITE_KEY is set at build time. The
 * Function enforces the token only when TURNSTILE_SECRET is set, so set both.
 */
import Layout from "../../layouts/Layout.astro";
import PhotoHero from "../PhotoHero.astro";
import SectionIntro from "../SectionIntro.astro";
import heroImage from "../../assets/contact/contact-hero.jpg";
import locationPictogram from "../../assets/pictograms/location.svg";
import phonePictogram from "../../assets/pictograms/phone.svg";
import emergencyPictogram from "../../assets/pictograms/emergency.svg";
import site from "../../data/site.json";
import type { Locale } from "../../i18n/config";
import { useTranslations } from "../../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const contact = t.contact;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Layout
  locale={locale}
  title={contact.meta.title}
  description={contact.meta.description}
  overlayNav
>
  <PhotoHero
    eyebrow={contact.hero.eyebrow}
    title={contact.hero.title}
    image={heroImage}
    focus="65% center"
    mobileFocus="84% center"
  />

  <SectionIntro
    eyebrow={contact.intro.eyebrow}
    heading={contact.intro.heading}
    paragraph={contact.intro.paragraph}
    measure="wide"
  >
    <ul class="grid w-full gap-10 text-center sm:grid-cols-3 sm:gap-8 lg:w-auto lg:grid-cols-[repeat(3,264px)]">
      <li class="flex flex-col items-center gap-2">
        <img src={locationPictogram.src} alt="" width="60" height="60" class="h-[60px] w-[60px]" loading="lazy" />
        <h3 class="font-serif text-lg font-medium leading-7 tracking-normal text-black">
          {contact.addressHeading}
        </h3>
        <p class="text-sm leading-6 text-black">
          {site.contact.addressLine1}<br />
          {site.contact.addressLine2}, {site.contact.country}
        </p>
      </li>
      <li class="flex flex-col items-center gap-2">
        <img src={phonePictogram.src} alt="" width="60" height="60" class="h-[60px] w-[60px]" loading="lazy" />
        <h3 class="font-serif text-lg font-medium leading-7 tracking-normal text-black">
          {contact.contactHeading}
        </h3>
        <p class="text-sm leading-6 text-black">
          {contact.phoneLabel}:{" "}
          <a href={site.contact.phoneHref} class="hover:underline">{site.contact.phone}</a>
          <br />
          {contact.emailLabel}:{" "}
          <a href={`mailto:${site.contact.email}`} class="break-all hover:underline">
            {site.contact.email}
          </a>
        </p>
      </li>
      <li class="flex flex-col items-center gap-2">
        <img src={emergencyPictogram.src} alt="" width="60" height="60" class="h-[60px] w-[60px]" loading="lazy" />
        <h3 class="font-serif text-lg font-medium leading-7 tracking-normal text-black">
          {contact.emergencyHeading}
        </h3>
        <p class="text-sm leading-6 text-black">
          <a href={site.contact.phoneHref} class="hover:underline">{site.contact.phone}</a>
        </p>
      </li>
    </ul>
  </SectionIntro>

  <!-- Booking form and map -->
  <section class="scroll-mt-20 bg-theme-surface-warm pb-12 pt-4 lg:pb-16 lg:pt-16" id="form">
    <div class="container">
      <div
        class="grid gap-12 rounded bg-theme-ink p-6 text-white sm:p-10 lg:grid-cols-2 lg:gap-20 lg:p-16"
      >
        <div class="flex flex-col gap-8">
          <div class="flex flex-col gap-6">
            <h2 class="font-serif text-3xl font-medium leading-tight tracking-normal lg:text-4xl">
              {contact.form.heading}
            </h2>
            <p class="text-base leading-7 tracking-[0.02em]">
              {
                contact.form.description.map((line, index) => (
                  <>
                    {index > 0 && <br />}
                    {line}
                  </>
                ))
              }
            </p>
          </div>

          <form
            id="contactForm"
            class="relative flex flex-col gap-6"
            method="POST"
            action="/api/contact"
            novalidate
            data-submitting={contact.form.submitting}
            data-success={contact.form.successMessage}
            data-error={contact.form.errorMessage}
            data-captcha={contact.form.captchaMessage}
          >
            <!-- Tells the endpoint which language the enquiry came from -->
            <input type="hidden" name="locale" value={locale} />
            <!--
              Honeypot: hidden from users, so anything that fills it is a bot.
              Kept out of the tab order and off screen rather than display:none,
              which some bots detect.
            -->
            <div class="absolute w-px h-px -left-[9999px] overflow-hidden" aria-hidden="true">
              <label for="company">Company</label>
              <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
            </div>

            <div class="flex flex-col gap-2">
              <label for="name" class="field-label">{contact.form.nameLabel}</label>
              <input class="field" type="text" id="name" name="name" autocomplete="name" required />
            </div>

            <div class="flex flex-col gap-2">
              <label for="email" class="field-label">{contact.form.emailLabel}</label>
              <input class="field" type="email" id="email" name="email" autocomplete="email" required />
            </div>

            <!-- Optional; /api/contact already includes it in the clinic's email -->
            <div class="flex flex-col gap-2">
              <label for="phone" class="field-label">{contact.phoneLabel}</label>
              <input class="field" type="tel" id="phone" name="phone" autocomplete="tel" />
            </div>

            <div class="flex flex-col gap-2">
              <label for="message" class="field-label">{contact.form.messageLabel}</label>
              <textarea
                class="field"
                id="message"
                name="message"
                rows="5"
                placeholder={contact.form.messagePlaceholder}></textarea>
            </div>

            {
              turnstileSiteKey && (
                <div
                  id="turnstileWidget"
                  class="-mb-6 data-[shown]:mb-0"
                  data-sitekey={turnstileSiteKey}
                  data-language={locale}
                />
              )
            }

            <div>
              <button type="submit" class="button button-light w-full justify-center">{contact.form.submit}</button>
            </div>

            <p
              id="contactFormStatus"
              class="text-sm font-medium text-white empty:hidden"
              role="status"
              aria-live="polite"
            >
            </p>
          </form>
        </div>

        <!-- Map -->
        <div class="min-h-[400px] overflow-hidden rounded">
          <iframe
            src={site.mapEmbedUrl}
            title={contact.mapTitle}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="h-full min-h-[400px] w-full"
            style="border: 0;"
            allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Form fields drawn in white on the brown panel */
  .field-label {
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.75rem;
    letter-spacing: 0.02em;
    color: #ffffff;
  }

  .field {
    margin-top: 0;
    min-height: 3rem;
    padding: 0.75rem;
    border-radius: 4px;
    background-color: transparent;
    color: #ffffff;
    outline: 1px solid #ffffff;
    outline-offset: -1px;
  }

  .field:focus {
    outline: 2px solid #ffffff;
    outline-offset: -2px;
  }

  .field::placeholder {
    color: rgb(255 255 255 / 0.7);
  }

  textarea.field {
    min-height: 11.25rem;
    resize: vertical;
  }
</style>

<script>
  /**
   * Submit the booking form without a page reload.
   *
   * The form has a real method/action, so it still works if this script never
   * runs: the browser posts normally and the Function responds. This only
   * improves the experience when JavaScript is available.
   */
  type Turnstile = {
    render: (el: HTMLElement, options: Record<string, unknown>) => string;
    getResponse: (id: string) => string | undefined;
    reset: (id: string) => void;
    remove: (id: string) => void;
  };

  let turnstileScript: Promise<Turnstile> | undefined;

  /**
   * Load the Turnstile API once. Explicit rendering is used because the site's
   * client-side router swaps pages without a reload, which the implicit
   * auto-render would miss.
   */
  function loadTurnstile(): Promise<Turnstile> {
    turnstileScript ??= new Promise((resolve, reject) => {
      const script = document.createElement("script");
      script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
      script.async = true;
      script.onload = () => resolve((window as unknown as { turnstile: Turnstile }).turnstile);
      script.onerror = () => {
        turnstileScript = undefined;
        reject(new Error("Turnstile failed to load"));
      };
      document.head.appendChild(script);
    });
    return turnstileScript;
  }

  function setupContactForm() {
    const form = document.getElementById("contactForm") as HTMLFormElement | null;
    const status = document.getElementById("contactFormStatus");
    if (!form || !status || form.dataset.bound === "true") return;

    form.dataset.bound = "true";
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const idleLabel = button?.textContent ?? "";

    // Turnstile widget, present only when a site key was configured at build.
    const widget = document.getElementById("turnstileWidget");
    let turnstile: Turnstile | undefined;
    let widgetId: string | undefined;
    if (widget) {
      loadTurnstile()
        .then((api) => {
          // The page may have been navigated away from while the script loaded.
          if (!widget.isConnected) return;
          turnstile = api;
          // Hidden unless Cloudflare needs the visitor to act, or the check
          // fails; until then the empty slot also cancels the form's gap.
          const show = () => {
            widget.dataset.shown = "";
          };
          widgetId = api.render(widget, {
            sitekey: widget.dataset.sitekey,
            language: widget.dataset.language,
            appearance: "interaction-only",
            "before-interactive-callback": show,
            "error-callback": show,
            "unsupported-callback": show,
          });
          // Drop the widget on navigation so a revisit renders a fresh one.
          document.addEventListener(
            "astro:before-swap",
            () => widgetId && api.remove(widgetId),
            { once: true }
          );
        })
        .catch(() => {
          // Leave the form usable; the Function will reject a missing token.
        });
    }

    /**
     * The check runs unseen, so a quick visitor can submit before it is done:
     * wait up to five seconds for its token before calling it a failure.
     */
    const turnstileToken = async () => {
      for (let waited = 0; ; waited += 250) {
        const token = turnstile && widgetId ? turnstile.getResponse(widgetId) : undefined;
        if (token || waited >= 5000) return token;
        await new Promise((resolve) => setTimeout(resolve, 250));
      }
    };

    const setStatus = (message: string, ok: boolean) => {
      status.textContent = message;
      // White on the brown panel either way; failures get a warm red tint.
      status.classList.toggle("text-white", ok);
      status.classList.toggle("text-red-200", !ok);
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      // novalidate is set so we control when native messages appear.
      if (!form.reportValidity()) return;

      if (button) {
        button.disabled = true;
        button.textContent = form.dataset.submitting ?? idleLabel;
      }
      status.textContent = "";

      if (widget && !(await turnstileToken())) {
        widget.dataset.shown = "";
        setStatus(form.dataset.captcha ?? "", false);
        if (button) {
          button.disabled = false;
          button.textContent = idleLabel;
        }
        return;
      }

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { accept: "application/json" },
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        setStatus(form.dataset.success ?? "", true);
        form.reset();
      } catch {
        setStatus(form.dataset.error ?? "", false);
      } finally {
        // Tokens are single use, so issue a fresh one for the next attempt.
        if (turnstile && widgetId) turnstile.reset(widgetId);
        if (button) {
          button.disabled = false;
          button.textContent = idleLabel;
        }
      }
    });
  }

  setupContactForm();
  document.addEventListener("astro:page-load", setupContactForm);
</script>
