---
/**
 * Dental tourism page body. Rendered by the localized route files.
 */
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import heroImage from "../../assets/clinic/entrance.jpg";
import introImage from "../../assets/clinic/treatment-panorama.jpg";
import PageHero from "../PageHero.astro";
import CallToActionSection from "../CallToActionSection.astro";
import Icon from "../Icon.astro";
import Heading from "../Heading.astro";
import type { Locale } from "../../i18n/config";
import { localizePath, useTranslations } from "../../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const tourism = t.tourism;
---

<Layout locale={locale} title={tourism.meta.title} description={tourism.meta.description}>
  <PageHero
    title={tourism.hero.title}
    description={tourism.hero.description}
    image={heroImage}
  />

  <!-- Intro -->
  <section class="section bg-theme-surface">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 items-center gap-12 lg:gap-16">
        <div class="space-y-5">
          <Heading level="h2">{tourism.intro.heading}</Heading>
          {
            tourism.intro.paragraphs.map((paragraph) => (
              <p class="text-base lg:text-lg text-theme-text-secondary leading-relaxed">
                {paragraph}
              </p>
            ))
          }
        </div>
        <div class="w-full">
          <Image
            src={introImage}
            alt={tourism.hero.title}
            class="w-full object-cover rounded-2xl shadow-xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section
    class="section bg-gradient-to-b from-theme-primary-lighter/15 via-theme-primary-lighter/5 to-theme-surface"
  >
    <div class="container">
      <div class="text-center mb-12">
        <Heading level="h2" align="center">{tourism.benefits.heading}</Heading>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          tourism.benefits.items.map((item) => (
            <div
              class="bg-theme-surface rounded-xl p-6 shadow-md border border-theme-border"
            >
              <div
                class="w-11 h-11 rounded-lg bg-theme-primary/10 flex items-center justify-center mb-4"
              >
                <Icon name="star" size="md" class="text-theme-primary" />
              </div>
              <h3 class="text-lg font-semibold text-theme-text-primary mb-2">
                {item.title}
              </h3>
              <p class="text-sm text-theme-text-secondary leading-relaxed">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section bg-theme-surface">
    <div class="container">
      <div class="text-center mb-12">
        <Heading level="h2" align="center">{tourism.howItWorks.heading}</Heading>
      </div>
      <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 max-w-6xl mx-auto">
        {
          tourism.howItWorks.steps.map((step) => (
            <li
              class="bg-theme-surface-muted rounded-xl p-6 border border-theme-border"
            >
              <h3 class="text-lg font-semibold text-theme-primary mb-2">
                {step.title}
              </h3>
              <p class="text-sm text-theme-text-secondary leading-relaxed">
                {step.description}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CallToActionSection
    heading={tourism.cta.heading}
    subheading={tourism.cta.subheading}
    primaryButtonText={tourism.cta.primaryButton}
    primaryButtonLink={localizePath("/contact", locale)}
    secondaryButtonText={tourism.cta.secondaryButton}
    secondaryButtonLink={localizePath("/services", locale)}
  />
</Layout>
