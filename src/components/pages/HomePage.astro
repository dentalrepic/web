---
/**
 * Home page body. Rendered by the localized route files.
 */
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import heroImage from "../../assets/hero-main.jpg";
import welcomeImage from "../../assets/team-professionals.jpg";
import whyUsImage from "../../assets/professional-staff.jpg";
import ctaImage from "../../assets/hero-services.jpg";
import ServicesIntroSection from "../ServicesIntroSection.astro";
import FaqAccordion from "../FaqAccordion.astro";
import Button from "../Button.astro";
import Icon from "../Icon.astro";
import Link from "../Link.astro";
import site from "../../data/site.json";
import type { Locale } from "../../i18n/config";
import { localizePath, useTranslations } from "../../i18n/utils";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = t.home;
---

<Layout locale={locale} title={home.meta.title} description={home.meta.description}>
	<!-- Hero Section -->
	<section
		class="relative min-h-[70vh] md:min-h-screen lg:min-h-[60vh] flex items-center py-16 md:py-0"
		aria-label={home.hero.title}
	>
		<div class="absolute inset-0 z-0">
			<Image
				src={heroImage}
				alt={home.hero.imageAlt}
				class="w-full h-full object-cover object-top"
				loading="eager"
				fetchpriority="high"
				width={1920}
				height={1080}
			/>
			<div class="absolute inset-0 bg-gradient-to-r from-black/70 to-black/40"></div>
		</div>

		<div class="container relative z-10">
			<div class="max-w-3xl text-white text-center md:text-left mx-auto md:mx-0">
				<h1
					class="text-4xl md:text-[clamp(2rem,4vw,3.5rem)] font-bold leading-[1.1] mb-4 md:mb-6 tracking-tight animate-fade-in"
				>
					{home.hero.title}
				</h1>
				<p
					class="text-lg md:text-[clamp(1rem,2vw,1.25rem)] mb-6 md:mb-10 opacity-95 leading-relaxed font-light max-w-md mx-auto md:mx-0 md:max-w-none"
				>
					{home.hero.subtitleLine1}<br class="hidden md:inline" />
					{home.hero.subtitleLine2}
				</p>
				<div class="flex flex-wrap gap-3 md:gap-4 justify-center md:justify-start">
					<Button
						variant="white"
						size="lg"
						href={localizePath("/contact", locale)}
						class="hover:shadow-xl hover:scale-105"
					>
						{home.hero.ctaPrimary}
					</Button>
					<Button
						variant="white-outline"
						size="lg"
						href={localizePath("/services", locale)}
						class="hover:shadow-xl"
					>
						{home.hero.ctaSecondary}
					</Button>
				</div>
				<p class="mt-6 text-white/90 text-sm md:text-base">
					<a
						href={site.contact.phoneHref}
						class="inline-flex items-center gap-2 font-semibold hover:text-white"
					>
						<Icon name="phone" size="sm" />
						<span>{site.contact.phone}</span>
					</a>
					<span class="mx-2 text-white/50">&middot;</span>
					<span>{t.common.callUsToday}</span>
				</p>
			</div>
		</div>
	</section>

	<!-- Welcome / About Section -->
	<section class="section bg-theme-surface">
		<div class="container">
			<div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
				<div class="order-2 lg:order-1">
					<p class="text-sm font-medium tracking-widest uppercase text-theme-primary mb-4">
						{home.welcome.eyebrow}
					</p>
					<h2 class="mb-6">{home.welcome.heading}</h2>
					<p class="text-theme-text-secondary text-lg leading-relaxed mb-8">
						{home.welcome.intro}
					</p>
					<ul class="space-y-5 mb-6">
						{
							home.welcome.highlights.map((highlight) => (
								<li class="flex items-start group">
									<div class="flex-shrink-0 w-8 h-8 rounded-full bg-theme-primary-lighter/20 flex items-center justify-center mr-4 mt-0.5 group-hover:bg-theme-primary transition-colors duration-300">
										<Icon
											name="check"
											size="sm"
											class="text-theme-primary group-hover:text-white transition-colors duration-300"
										/>
									</div>
									<div>
										<h3 class="text-base lg:text-lg font-semibold text-theme-text-primary mb-1">
											{highlight.title}
										</h3>
										<p class="text-theme-text-secondary">{highlight.description}</p>
									</div>
								</li>
							))
						}
					</ul>
					<div class="text-center md:text-left">
						<Link href={localizePath("/about", locale)}>{home.welcome.link}</Link>
					</div>
				</div>
				<div class="order-1 lg:order-2">
					<div class="relative">
						<div class="rounded-2xl overflow-hidden shadow-xl">
							<Image
								src={welcomeImage}
								alt={home.welcome.imageAlt}
								class="w-full h-auto"
								loading="lazy"
							/>
						</div>
						<div
							class="absolute -bottom-4 -left-4 w-24 h-24 bg-theme-primary-lighter/30 rounded-2xl -z-10"
						></div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Services Section -->
	<section
		class="section bg-gradient-to-b from-theme-primary-lighter/10 via-theme-primary-lighter/5 to-theme-surface"
	>
		<ServicesIntroSection locale={locale} />
	</section>

	<!-- Why Us Section -->
	<section class="section bg-theme-surface">
		<div class="container">
			<div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
				<div>
					<h2 class="mb-4">{home.whyUs.heading}</h2>
					<p class="text-lg text-theme-text-secondary mb-8">
						{home.whyUs.subheading}
					</p>
					<ul class="flex flex-wrap gap-2.5">
						{
							home.whyUs.reasons.map((reason) => (
								<li
									class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full bg-theme-primary-lighter/15 border border-theme-primary-lighter/40 text-sm font-medium text-theme-primary-darker"
								>
									<Icon name="check" size="sm" class="text-theme-primary flex-shrink-0" />
									<span>{reason}</span>
								</li>
							))
						}
					</ul>
				</div>
				<div class="w-full">
					<Image
						src={whyUsImage}
						alt={home.whyUs.imageAlt}
						class="w-full object-cover rounded-2xl shadow-xl"
						loading="lazy"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- Problems We Solve -->
	<section class="section bg-gradient-to-b from-theme-surface-muted to-theme-surface">
		<div class="container">
			<div class="narrow mx-auto text-center mb-12">
				<h2>{home.problems.heading}</h2>
			</div>
			<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
				{
					home.problems.items.map((item) => (
						<div
							class="bg-theme-surface rounded-xl p-6 shadow-md border border-theme-border hover:shadow-lg transition-shadow duration-300"
						>
							<div
								class="w-11 h-11 rounded-lg bg-theme-primary/10 flex items-center justify-center mb-4"
							>
								<Icon name="medical" size="md" class="text-theme-primary" />
							</div>
							<h3 class="text-lg font-semibold text-theme-text-primary mb-2">
								{item.title}
							</h3>
							<p class="text-sm text-theme-text-secondary leading-relaxed">
								{item.description}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- FAQ Section -->
	<section class="section bg-theme-surface">
		<div class="container">
			<div class="narrow mx-auto">
				<div class="text-center mb-12">
					<p class="text-sm font-medium tracking-widest uppercase text-theme-primary mb-4">
						{home.faq.eyebrow}
					</p>
					<h2>{home.faq.heading}</h2>
				</div>
				<FaqAccordion items={t.faqs.slice(0, 4)} />
				<div class="text-center mt-10">
					<Link href={localizePath("/info", locale)}>{home.faq.viewAll}</Link>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="relative py-20 lg:py-28 overflow-hidden">
		<div class="absolute inset-0">
			<Image
				src={ctaImage}
				alt={home.hero.imageAlt}
				class="w-full h-full object-cover"
				loading="lazy"
			/>
			<div class="absolute inset-0 bg-theme-primary-darker/90"></div>
		</div>
		<div class="relative container">
			<div class="max-w-2xl mx-auto text-center text-white">
				<h2 class="mb-6">{home.cta.heading}</h2>
				<p class="text-lg mb-10 text-white/85">{home.cta.text}</p>
				<div class="flex flex-col sm:flex-row justify-center gap-4">
					<Button variant="white" href={localizePath("/contact", locale)} showIcon={true}>
						{home.cta.button}
					</Button>
					<Button variant="white-outline" href={site.contact.phoneHref}>
						{site.contact.phone}
					</Button>
				</div>
			</div>
		</div>
	</section>
</Layout>
