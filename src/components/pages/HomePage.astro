---
/**
 * Home page body. Rendered by the localized route files.
 *
 * Layout follows the "Početna" design: a photo hero, the four headline
 * treatments, the team, a short note on the visit, a carousel of photos of
 * the clinic, the clinic's video, then the booking band.
 */
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import PhotoHero from "../PhotoHero.astro";
import SectionIntro from "../SectionIntro.astro";
import BookingBand from "../BookingBand.astro";
import Icon from "../Icon.astro";
import heroImage from "../../assets/home/home-hero.jpg";
import teamImage from "../../assets/home/team.jpg";
import clinic1 from "../../assets/home/clinic-1.jpg";
import clinic2 from "../../assets/home/clinic-2.jpg";
import clinic3 from "../../assets/home/clinic-3.jpg";
import clinic4 from "../../assets/home/clinic-4.jpg";
import clinic5 from "../../assets/home/clinic-5.jpg";
import clinic6 from "../../assets/home/clinic-6.jpg";
import clinic7 from "../../assets/home/clinic-7.jpg";
import videoPoster from "../../assets/home/video-poster.jpg";
import generalPictogram from "../../assets/pictograms/general-dentistry.svg";
import implantPictogram from "../../assets/pictograms/implantology.svg";
import aestheticPictogram from "../../assets/pictograms/aesthetic-dentistry.svg";
import orthodonticPictogram from "../../assets/pictograms/orthodontics.svg";
import type { Locale } from "../../i18n/config";
import { localizePath, useTranslations } from "../../i18n/utils";
import site from "../../data/site.json";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = t.home;

// Pictograms pair positionally with home.services.items.
const pictograms = [generalPictogram, implantPictogram, aestheticPictogram, orthodonticPictogram];
const services = home.services.items.map((item, index) => ({
	...item,
	pictogram: pictograms[index],
}));

// The two specialists head the staff list on the about page.
const doctors = t.about.team.slice(0, 2);

// Vimeo's do-not-track mode: no cookies, no viewing analytics.
const videoSrc = `https://player.vimeo.com/video/${site.video.vimeoId}?autoplay=1&dnt=1`;

// Gallery photos pair positionally with home.space.photoAlts.
const gallery = [clinic1, clinic2, clinic3, clinic4, clinic5, clinic6, clinic7].map(
	(image, index) => ({ image, alt: home.space.photoAlts[index] ?? "" }),
);
---

<Layout
	locale={locale}
	title={home.meta.title}
	description={home.meta.description}
	overlayNav
>
	<PhotoHero
		eyebrow={home.hero.eyebrow}
		title={home.hero.title}
		lead={home.hero.lead}
		image={heroImage}
		focus="70% center"
		eyebrowTone="ink"
		align="center"
	>
		<a class="button button-ink" href={localizePath("/contact#form", locale)}>
			{home.hero.ctaPrimary}
		</a>
		<a class="button button-ink-outline" href={localizePath("/services", locale)}>
			{home.hero.ctaSecondary}
		</a>
	</PhotoHero>

	<!-- Headline treatments -->
	<SectionIntro
		eyebrow={home.services.eyebrow}
		heading={home.services.heading}
		paragraph={home.services.paragraph}
	>
		<ul class="grid w-full grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4 lg:gap-8">
			{
				services.map((service) => (
					<li class="flex flex-col items-center gap-2 text-center">
						<img
							src={service.pictogram.src}
							alt=""
							width="60"
							height="60"
							class="h-[60px] w-[60px]"
							loading="lazy"
						/>
						<h3 class="font-serif text-lg font-medium leading-7 tracking-normal text-black">
							{service.title}
						</h3>
						<p class="text-sm leading-6 text-black">{service.summary}</p>
					</li>
				))
			}
		</ul>
		<a class="button button-ink-outline" href={localizePath("/services", locale)}>
			{home.services.cta}
		</a>
	</SectionIntro>

	<!-- Team -->
	<section class="bg-theme-surface py-12">
		<div class="container">
			<div class="flex flex-col-reverse items-center gap-10 lg:flex-row lg:gap-20">
				<div class="flex w-full flex-col items-start gap-10 lg:max-w-[464px]">
					<div class="flex flex-col gap-8">
						<div class="flex flex-col gap-12">
							<div class="flex flex-col gap-4">
								<p class="eyebrow text-theme-ink">{home.team.eyebrow}</p>
								<h2 class="font-serif text-3xl font-medium leading-tight tracking-normal text-black lg:text-4xl">
									{home.team.heading}
								</h2>
							</div>
							<div class="text-theme-ink">
								{
									home.team.paragraphs.map((paragraph) => (
										<p class="text-base leading-7 tracking-[0.02em]">{paragraph}</p>
									))
								}
							</div>
						</div>
						<ul class="flex flex-col gap-4">
							{
								doctors.map((doctor) => (
									<li class="text-xs leading-[18px] tracking-[0.02em]">
										<span class="block font-medium uppercase text-black">{doctor.name}</span>
										<span class="block text-theme-ink">{doctor.role}</span>
									</li>
								))
							}
						</ul>
					</div>
					<a class="button button-ink" href={localizePath("/about", locale)}>
						{home.team.cta}
					</a>
				</div>
				<Image
					src={teamImage}
					alt={home.team.imageAlt}
					widths={[640, 960, 1280]}
					sizes="(min-width: 1024px) 608px, 100vw"
					class="aspect-[608/452] w-full rounded object-cover lg:w-auto lg:min-w-0 lg:flex-1"
					loading="lazy"
				/>
			</div>
		</div>
	</section>

	<!-- The visit -->
	<SectionIntro
		eyebrow={home.visit.eyebrow}
		heading={home.visit.heading}
		paragraph={home.visit.paragraph}
	/>

	<!-- The clinic -->
	<section class="bg-theme-surface py-12">
		<div class="container">
			<div class="flex flex-col gap-10 lg:flex-row lg:items-center lg:justify-between">
				<div class="flex flex-col gap-12 lg:max-w-[480px]">
					<div class="flex flex-col gap-4">
						<p class="eyebrow text-theme-ink">{home.space.eyebrow}</p>
						<h2 class="font-serif text-3xl font-medium leading-tight tracking-normal text-black lg:text-4xl">
							{home.space.heading}
						</h2>
					</div>
					<p class="text-base leading-7 tracking-[0.02em] text-theme-ink">
						{home.space.paragraph}
					</p>
				</div>

				<!--
					Photo carousel: the arrows step one photo at a time, and the
					strip also scrolls with touch, trackpad or the keyboard (it
					takes focus), snapping to each photo. The next photo peeks in
					at the edge to show there is more.
				-->
				<div class="gallery-carousel relative lg:w-[612px] lg:shrink-0">
					<ul
						class="gallery -mx-4 flex snap-x snap-mandatory gap-8 overflow-x-auto px-4 md:-mx-8 md:px-8 lg:mx-0 lg:px-0"
						tabindex="0"
						aria-label={home.space.galleryLabel}
					>
						{
							gallery.map((photo) => (
								<li class="w-[82%] shrink-0 snap-start sm:w-[496px]">
									<Image
										src={photo.image}
										alt={photo.alt}
										widths={[496, 992]}
										sizes="496px"
										class="aspect-[496/452] w-full rounded object-cover"
										loading="lazy"
									/>
								</li>
							))
						}
					</ul>
					<button
						type="button"
						class="gallery-button left-3"
						data-direction="-1"
						aria-label={home.space.previousLabel}
						disabled
					>
						<Icon name="arrow-left" size="sm" />
					</button>
					<button
						type="button"
						class="gallery-button right-3"
						data-direction="1"
						aria-label={home.space.nextLabel}
					>
						<Icon name="arrow-right" size="sm" />
					</button>
				</div>
			</div>
		</div>
	</section>

	<!--
		The clinic's video, hosted on Vimeo. The poster and play button stand in
		for the player until clicked, so the page loads nothing from Vimeo for
		visitors who never press play. Without JavaScript the button is a link
		to the video on Vimeo.
	-->
	<section class="bg-theme-surface pb-12">
		<div class="container">
			<div
				class="video relative aspect-video w-full overflow-hidden rounded bg-theme-ink"
				data-src={videoSrc}
				data-title={home.space.videoTitle}
			>
				<a
					href={`https://vimeo.com/${site.video.vimeoId}`}
					class="video-play group absolute inset-0 block"
					aria-label={home.space.playLabel}
				>
					<Image
						src={videoPoster}
						alt=""
						widths={[640, 1152, 1600, 1920]}
						sizes="(min-width: 1280px) 1152px, 100vw"
						class="h-full w-full object-cover"
						loading="lazy"
					/>
					<span class="absolute inset-0 bg-black/20 transition-colors group-hover:bg-black/30"></span>
					<svg
						class="absolute left-1/2 top-1/2 h-16 w-16 -translate-x-1/2 -translate-y-1/2 text-white drop-shadow transition-transform group-hover:scale-110"
						viewBox="0 0 64 64"
						fill="none"
						aria-hidden="true"
					>
						<path
							fill="currentColor"
							fill-rule="evenodd"
							clip-rule="evenodd"
							d="M5.33301 31.9999C5.33301 17.2723 17.2721 5.33325 31.9997 5.33325C39.0721 5.33325 45.8549 8.14277 50.8559 13.1437C55.8568 18.1447 58.6663 24.9275 58.6663 31.9999C58.6663 46.7275 46.7273 58.6666 31.9997 58.6666C17.2721 58.6666 5.33301 46.7275 5.33301 31.9999ZM27.1198 43.4133L42.6664 33.7066C43.2482 33.334 43.6001 32.6908 43.6001 31.9999C43.6001 31.3091 43.2482 30.6658 42.6664 30.2933L27.0664 20.5866C26.452 20.1992 25.6758 20.1754 25.0388 20.5243C24.4018 20.8733 24.004 21.5402 23.9998 22.2666V41.7333C23.9912 42.4773 24.3963 43.1646 25.0514 43.5173C25.7065 43.8701 26.5033 43.83 27.1198 43.4133Z"
						></path>
					</svg>
				</a>
			</div>
		</div>
	</section>

	<BookingBand locale={locale} />
</Layout>

<style>
	/* Hide the scrollbar on the photo strip; it still scrolls normally. */
	.gallery {
		scrollbar-width: none;
	}

	.gallery::-webkit-scrollbar {
		display: none;
	}

	.gallery:focus-visible {
		outline: 2px solid var(--color-theme-ink);
		outline-offset: 4px;
	}

	/* Round white arrows over the photos, hidden at either end of the strip */
	.gallery-button {
		position: absolute;
		top: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 9999px;
		background-color: rgb(255 255 255 / 0.9);
		color: var(--color-theme-ink);
		box-shadow: 0 2px 8px rgb(0 0 0 / 0.15);
		transform: translateY(-50%);
		transition:
			opacity 200ms ease,
			background-color 150ms ease;
	}

	.gallery-button:hover {
		background-color: #ffffff;
	}

	.gallery-button:active:not(:disabled) {
		transform: translateY(-50%) scale(0.95);
	}

	.gallery-button:disabled {
		opacity: 0;
		pointer-events: none;
	}
</style>

<script>
	/** Wire the carousel arrows: step one photo, and hide an arrow at its end. */
	function setupGallery() {
		document.querySelectorAll<HTMLElement>(".gallery-carousel").forEach((carousel) => {
			const strip = carousel.querySelector<HTMLElement>(".gallery");
			if (!strip || carousel.dataset.bound === "true") return;
			carousel.dataset.bound = "true";

			const buttons = carousel.querySelectorAll<HTMLButtonElement>(".gallery-button");
			const step = () => {
				const item = strip.querySelector("li");
				const gap = parseFloat(getComputedStyle(strip).columnGap) || 0;
				return (item?.getBoundingClientRect().width ?? strip.clientWidth) + gap;
			};
			const update = () => {
				const max = strip.scrollWidth - strip.clientWidth - 1;
				buttons.forEach((button) => {
					const forward = button.dataset.direction === "1";
					button.disabled = forward ? strip.scrollLeft >= max : strip.scrollLeft <= 1;
				});
			};

			buttons.forEach((button) =>
				button.addEventListener("click", () => {
					strip.scrollBy({ left: Number(button.dataset.direction) * step(), behavior: "smooth" });
				}),
			);
			strip.addEventListener("scroll", update, { passive: true });
			window.addEventListener("resize", update);
			update();
		});
	}

	setupGallery();
	document.addEventListener("astro:page-load", setupGallery);

	/** Swap the video poster for the Vimeo player, playing, on click. */
	function setupVideo() {
		document.querySelectorAll<HTMLElement>(".video").forEach((video) => {
			const play = video.querySelector<HTMLAnchorElement>(".video-play");
			if (!play || video.dataset.bound === "true") return;
			video.dataset.bound = "true";

			play.addEventListener("click", (event) => {
				event.preventDefault();
				const iframe = document.createElement("iframe");
				iframe.src = video.dataset.src ?? "";
				iframe.title = video.dataset.title ?? "";
				iframe.allow = "autoplay; fullscreen; picture-in-picture";
				iframe.allowFullscreen = true;
				iframe.className = "absolute inset-0 h-full w-full";
				iframe.style.border = "0";
				play.replaceWith(iframe);
				iframe.focus();
			});
		});
	}

	setupVideo();
	document.addEventListener("astro:page-load", setupVideo);
</script>
