---
/**
 * One service detail page, e.g. /services/implantologija.
 *
 * Copy comes from `serviceDetails` in the locale files, which is a partial
 * record: these pages exist only in the languages the clinic wrote them in. The
 * route files never render a locale that lacks the page, so `detail` here is
 * always defined.
 */
import Layout from "../../layouts/Layout.astro";
import PageHero from "../PageHero.astro";
import CallToActionSection from "../CallToActionSection.astro";
import FaqAccordion from "../FaqAccordion.astro";
import Heading from "../Heading.astro";
import Icon from "../Icon.astro";
import heroImage from "../../assets/hero-services.jpg";
import endodonticsHero from "../../assets/services/endodoncija-detail.jpg";
import prostheticsHero from "../../assets/services/protetika-detail.jpg";
import type { Locale } from "../../i18n/config";
import { localizePath, useTranslations } from "../../i18n/utils";
import { getServiceDetail, getServiceDetails } from "../../i18n/services";
import type { ServiceDetailSlug } from "../../i18n/types";

interface Props {
  locale: Locale;
  slug: ServiceDetailSlug;
}

const { locale, slug } = Astro.props;
const t = useTranslations(locale);
const chrome = t.serviceDetailChrome;

const detail = getServiceDetail(slug, locale);
if (!detail) {
  // Unreachable via the generated routes; guards against a stale link.
  return Astro.redirect(localizePath("/services", locale));
}

// Pages with a photo of their own; the rest share the default hero image.
const heroImages: Partial<Record<ServiceDetailSlug, ImageMetadata>> = {
  // From the clinic's old endodontics page on dentalrepic.com.hr.
  endodoncija: endodonticsHero,
  // Same photo as the prosthetics card on the services page.
  protetika: prostheticsHero,
};

// Sibling pages available in this language, for the list at the foot.
const related = getServiceDetails(locale).filter((entry) => entry.slug !== slug);

const servicesHref = localizePath("/services", locale);

// Structured data for the FAQ block, matching what the FAQ page does.
const faqLd = detail.faqs?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      inLanguage: locale,
      mainEntity: detail.faqs.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer.replace(/<[^>]*>/g, ""),
        },
      })),
    }
  : null;
---

<Layout locale={locale} title={detail.meta.title} description={detail.meta.description}>
  <PageHero title={detail.title} description={detail.lead} image={heroImages[slug] ?? heroImage} />

  <section class="section bg-theme-surface">
    <div class="container">
      <!-- Back to the services index -->
      <a
        href={servicesHref}
        class="inline-flex items-center gap-2 mb-8 text-sm font-semibold text-theme-primary hover:text-theme-primary-dark"
      >
        <Icon name="arrow-left" size="sm" />
        {chrome.backToServices}
      </a>

      <div class="narrow">
        <p
          class="text-sm font-semibold uppercase tracking-wide text-theme-primary mb-8"
        >
          {detail.eyebrow}
        </p>

        {
          detail.sections.map((section) => (
            <div class="mb-10 last:mb-0">
              {section.heading && (
                <Heading level="h2" size="section" class="mb-4">
                  {section.heading}
                </Heading>
              )}
              {section.paragraphs?.map((paragraph) => (
                <p class="mb-4 text-base lg:text-lg leading-relaxed text-theme-text-secondary">
                  {paragraph}
                </p>
              ))}
              {section.bullets && (
                <ul class="mt-4 space-y-2">
                  {section.bullets.map((bullet) => (
                    <li class="flex items-start gap-3">
                      <Icon
                        name="check"
                        size="sm"
                        class="text-theme-primary flex-shrink-0 mt-1.5"
                      />
                      <span class="text-base lg:text-lg text-theme-text-secondary">
                        {bullet}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    detail.faqs && detail.faqs.length > 0 && (
      <section class="section bg-theme-surface-muted">
        <div class="container">
          <div class="narrow">
            <Heading level="h2" class="mb-8">
              {chrome.faqHeading}
            </Heading>
            <FaqAccordion items={detail.faqs} />
          </div>
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="section-sm bg-theme-surface">
        <div class="container">
          <Heading level="h2" size="section" class="mb-6">
            {chrome.relatedHeading}
          </Heading>
          <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {related.map((entry) => (
              <li>
                <a
                  href={localizePath(`/services/${entry.slug}`, locale)}
                  class="flex items-center justify-between gap-3 rounded-xl border border-theme-border bg-theme-surface p-4 font-semibold text-theme-text-primary transition-colors hover:border-theme-primary hover:text-theme-primary"
                >
                  {entry.title}
                  <Icon name="arrow-right" size="sm" class="flex-shrink-0" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    faqLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    )
  }

  <CallToActionSection
    heading={chrome.cta.heading}
    subheading={chrome.cta.subheading}
    primaryButtonText={chrome.cta.primaryButton}
    primaryButtonLink={localizePath("/contact#form", locale)}
  />
</Layout>
