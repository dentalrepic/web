---
/**
 * One service detail page, e.g. /services/implantologija.
 *
 * Layout follows the "Usluge Extended" design: the title and summary beside
 * the service's photo, then a back link beside the text sections, the FAQ,
 * the other services and the booking band.
 *
 * Copy comes from `serviceDetails` in the locale files, which is a partial
 * record: these pages exist only in the languages the clinic wrote them in. The
 * route files never render a locale that lacks the page, so `detail` here is
 * always defined.
 */
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import BookingBand from "../BookingBand.astro";
import FaqAccordion from "../FaqAccordion.astro";
import Icon from "../Icon.astro";
import { serviceImages } from "../../data/serviceImages";
import type { Locale } from "../../i18n/config";
import { localizePath, useTranslations } from "../../i18n/utils";
import { getServiceDetail, getServiceDetails } from "../../i18n/services";
import type { ServiceDetailSlug } from "../../i18n/types";

interface Props {
  locale: Locale;
  slug: ServiceDetailSlug;
}

const { locale, slug } = Astro.props;
const t = useTranslations(locale);
const chrome = t.serviceDetailChrome;

const detail = getServiceDetail(slug, locale);
if (!detail) {
  // Unreachable via the generated routes; guards against a stale link.
  return Astro.redirect(localizePath("/services", locale));
}

// Sibling pages available in this language, for the list at the foot.
const related = getServiceDetails(locale).filter((entry) => entry.slug !== slug);

const servicesHref = localizePath("/services", locale);

// Structured data for the FAQ block, matching what the FAQ page does.
const faqLd = detail.faqs?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      inLanguage: locale,
      mainEntity: detail.faqs.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer.replace(/<[^>]*>/g, ""),
        },
      })),
    }
  : null;
---

<Layout locale={locale} title={detail.meta.title} description={detail.meta.description}>
  <!-- Intro: title and summary beside the service's photo -->
  <section class="bg-theme-surface-warm py-12">
    <div class="container flex flex-col gap-10 lg:flex-row lg:items-center lg:gap-20">
      <div class="flex flex-col gap-6 lg:w-[464px] lg:shrink-0 lg:gap-12">
        <h1 class="text-3xl font-normal leading-tight tracking-[0.02em] text-black lg:text-4xl">
          {detail.title}
        </h1>
        <p class="text-base leading-7 tracking-[0.02em] text-theme-ink">{detail.lead}</p>
      </div>
      <Image
        src={serviceImages[slug]}
        alt=""
        widths={[608, 912, 1216]}
        sizes="(min-width: 1024px) 608px, 100vw"
        class="aspect-[608/400] w-full rounded object-cover lg:min-w-0 lg:flex-1"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <!-- Back to the services index, beside the text -->
  <section class="bg-theme-surface py-12">
    <div class="container flex flex-col gap-8 lg:flex-row">
      <div class="lg:w-64 lg:shrink-0 lg:p-6">
        <a
          href={servicesHref}
          class="text-lg font-medium leading-7 tracking-[0.02em] text-black"
        >
          <span aria-hidden="true">&larr;</span>{" "}{chrome.backToServices}
        </a>
      </div>

      <div class="flex max-w-[754px] flex-col gap-8 lg:p-6">
        {
          detail.sections.map((section) => (
            <div class="flex flex-col gap-2">
              {section.heading && (
                <h2 class="text-lg font-medium leading-7 tracking-[0.02em] text-black">
                  {section.heading}
                </h2>
              )}
              <div class="text-base leading-7 tracking-[0.02em] text-black/55">
                {section.paragraphs?.map((paragraph) => (
                  <p class="mt-7 first:mt-0">{paragraph}</p>
                ))}
                {section.bullets && (
                  <ul class="pl-2">
                    {section.bullets.map((bullet) => (
                      <li class="flex gap-3">
                        <span aria-hidden="true">&bull;</span>
                        {bullet}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    detail.faqs && detail.faqs.length > 0 && (
      <section class="section bg-theme-surface-warm">
        <div class="container">
          <div class="narrow">
            <h2 class="text-2xl font-medium leading-tight tracking-[0.02em] text-black lg:text-3xl mb-8">
              {chrome.faqHeading}
            </h2>
            <FaqAccordion items={detail.faqs} hover={false} />
          </div>
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="section-sm bg-theme-surface">
        <div class="container">
          <h2 class="text-2xl font-medium leading-tight tracking-[0.02em] text-black lg:text-3xl mb-6">
            {chrome.relatedHeading}
          </h2>
          <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {related.map((entry) => (
              <li>
                <a
                  href={localizePath(`/services/${entry.slug}`, locale)}
                  class="flex items-center justify-between gap-3 rounded border border-black/10 bg-theme-surface p-4 font-medium tracking-[0.02em] text-black"
                >
                  {entry.title}
                  <Icon name="arrow-right" size="sm" class="flex-shrink-0" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    faqLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    )
  }

  <BookingBand locale={locale} />
</Layout>
