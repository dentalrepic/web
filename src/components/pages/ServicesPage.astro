---
/**
 * Services page body. Rendered by the localized route files.
 *
 * Layout follows the "Usluge" design: a full-width photo, a short
 * introduction, a card per service, then the booking band.
 */
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import PhotoHero from "../PhotoHero.astro";
import SectionIntro from "../SectionIntro.astro";
import BookingBand from "../BookingBand.astro";
import heroImage from "../../assets/services/services-hero.jpg";
import { serviceImages } from "../../data/serviceImages";
import type { Locale } from "../../i18n/config";
import type { ServiceDetailSlug } from "../../i18n/types";
import { localizePath, useTranslations } from "../../i18n/utils";
import { getServiceDetail } from "../../i18n/services";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const services = t.services;

// Service per card, paired positionally with services.cards. Its photo is
// shared with the service's detail page; see data/serviceImages.ts.
const cardSlugs: ServiceDetailSlug[] = [
  "implantologija",
  "ortodoncija",
  "endodoncija",
  "protetika",
  "estetska-dentalna-medicina",
  "oralna-kirurgija",
  "parodontologija",
  "rtg-dijagnostika",
  "djecja-dentalna-medicina",
];

const cards = services.cards.map((card, index) => {
  const slug = cardSlugs[index];
  const image = slug ? serviceImages[slug] : undefined;
  // Link only where this language has the page; see i18n/services.ts.
  const href =
    slug && getServiceDetail(slug, locale)
      ? localizePath(`/services/${slug}`, locale)
      : undefined;
  return { ...card, image, href };
});
---

<Layout
  locale={locale}
  title={services.meta.title}
  description={services.meta.description}
  overlayNav
>
  <PhotoHero
    eyebrow={services.hero.eyebrow}
    title={services.hero.title}
    image={heroImage}
    focus="70% center"
    shade
  />

  <SectionIntro
    eyebrow={services.intro.eyebrow}
    heading={services.intro.heading}
    paragraph={services.intro.paragraph}
    measure="wide"
  />

  <!-- Service cards -->
  <section class="bg-theme-surface py-12">
    <div class="container">
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
        {
          cards.map((card) => {
            const Tag = card.href ? "a" : "div";
            return (
              <li>
                <Tag
                  href={card.href}
                  class="flex h-full flex-col overflow-hidden rounded border border-black/10 bg-theme-surface"
                >
                  {card.image && (
                    <div class="h-60 overflow-hidden">
                      <Image
                        src={card.image}
                        alt=""
                        widths={[400, 600, 800]}
                        sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                    </div>
                  )}
                  <div class="flex flex-1 flex-col p-6">
                    <h2 class="mb-2 text-lg font-medium leading-7 tracking-[0.02em] text-black">
                      {card.title}
                    </h2>
                    <p class="text-base leading-7 tracking-[0.02em] text-black/55">
                      {card.summary}
                    </p>
                    {card.href && (
                      <span class="mt-auto pt-8 text-base leading-7 tracking-[0.02em] text-black">
                        {t.common.learnMore} <span aria-hidden="true">&rarr;</span>
                      </span>
                    )}
                  </div>
                </Tag>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <BookingBand locale={locale} />
</Layout>
