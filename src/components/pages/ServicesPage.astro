---
/**
 * Services page body. Rendered by the localized route files.
 */
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import heroImage from "../../assets/hero-services.jpg";
import equipmentImage from "../../assets/service-detail.jpg";
import PageHero from "../PageHero.astro";
import CallToActionSection from "../CallToActionSection.astro";
import Icon from "../Icon.astro";
import CheckListItem from "../CheckListItem.astro";
import Heading from "../Heading.astro";
import type { IconName } from "../../types/icons";
import type { Locale } from "../../i18n/config";
import { localizePath, useTranslations } from "../../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const services = t.services;

// Icon and accent per service group, paired positionally with the translations.
const groupStyles: Array<{ icon: IconName; iconWrapperClass: string }> = [
  { icon: "medical", iconWrapperClass: "bg-theme-primary" },
  { icon: "star", iconWrapperClass: "bg-[color:var(--color-theme-accent-sky)]" },
  { icon: "heart", iconWrapperClass: "bg-theme-primary-light" },
  { icon: "star", iconWrapperClass: "bg-[color:var(--color-theme-accent-orange)]" },
  { icon: "clipboard", iconWrapperClass: "bg-theme-primary-dark" },
  { icon: "users", iconWrapperClass: "bg-theme-primary" },
];

const groups = services.groups.map((group, index) => ({
  ...group,
  ...groupStyles[index % groupStyles.length],
}));
---

<Layout locale={locale} title={services.meta.title} description={services.meta.description}>
  <PageHero
    title={services.hero.title}
    description={services.hero.description}
    image={heroImage}
  />

  <!-- Intro -->
  <section class="section-sm bg-gradient-to-b from-theme-surface to-theme-surface-muted">
    <div class="container">
      <div class="narrow mx-auto text-center space-y-5">
        <Heading level="h2" align="center">{services.intro.heading}</Heading>
        <p class="text-lg lg:text-xl text-theme-text-secondary leading-relaxed">
          {services.intro.paragraph}
        </p>
      </div>
    </div>
  </section>

  <!-- Treatment catalogue -->
  <section class="section bg-theme-surface-muted">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {
          groups.map((group) => (
            <div
              class="bg-theme-surface rounded-xl p-6 lg:p-8 border border-theme-border shadow-md"
            >
              <div class="flex items-center gap-3 mb-6">
                <div
                  class:list={[
                    "w-12 h-12 rounded-lg flex items-center justify-center flex-shrink-0",
                    group.iconWrapperClass,
                  ]}
                >
                  <Icon name={group.icon} size="lg" class="text-white" />
                </div>
                <h2 class="text-xl font-bold text-theme-text-primary">{group.title}</h2>
              </div>
              <ul class="space-y-3">
                {group.items.map((item) => (
                  <CheckListItem>{item}</CheckListItem>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Equipment -->
  <section class="section bg-theme-surface">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 items-center gap-12 lg:gap-16">
        <div class="space-y-6">
          <Heading level="h2">{services.equipment.heading}</Heading>
          <p class="text-base lg:text-lg text-theme-text-secondary leading-relaxed">
            {services.equipment.paragraph}
          </p>
          <div
            class="bg-theme-surface-muted rounded-xl p-6 lg:p-8 border border-theme-border"
          >
            <div class="space-y-4">
              {
                services.equipment.features.map((feature) => (
                  <div class="flex items-start gap-3">
                    <Icon
                      name="check"
                      size="md"
                      class="text-theme-primary flex-shrink-0 mt-1"
                    />
                    <div>
                      <h3 class="font-semibold text-theme-text-primary mb-1">
                        {feature.title}
                      </h3>
                      <p class="text-theme-text-secondary">{feature.description}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
        <div class="w-full">
          <Image
            src={equipmentImage}
            alt={services.equipment.imageAlt}
            class="w-full object-cover rounded-2xl shadow-xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <CallToActionSection
    heading={services.cta.heading}
    subheading={services.cta.subheading}
    primaryButtonText={services.cta.primaryButton}
    primaryButtonLink={localizePath("/contact", locale)}
    secondaryButtonText={services.cta.secondaryButton}
    secondaryButtonLink={localizePath("/dental-tourism", locale)}
  />
</Layout>
