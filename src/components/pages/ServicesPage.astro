---
/**
 * Services page body. Rendered by the localized route files.
 *
 * Layout follows the "Usluge" design: a full-width photo, a short
 * introduction, a card per service, then the booking band.
 */
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import PhotoHero from "../PhotoHero.astro";
import SectionIntro from "../SectionIntro.astro";
import BookingBand from "../BookingBand.astro";
import heroImage from "../../assets/services/services-hero.jpg";
import implantsImage from "../../assets/services/implantologija.jpg";
import orthodonticsImage from "../../assets/services/ortodoncija.jpg";
import endodonticsImage from "../../assets/services/endodoncija.jpg";
import prostheticsImage from "../../assets/services/protetika.jpg";
import aestheticImage from "../../assets/services/estetska-dentalna-medicina.jpg";
import oralSurgeryImage from "../../assets/services/oralna-kirurgija.jpg";
import periodontologyImage from "../../assets/services/parodontologija.jpg";
import xrayImage from "../../assets/services/rtg-dijagnostika.jpg";
import paediatricImage from "../../assets/services/djecja-dentalna-medicina.jpg";
import type { Locale } from "../../i18n/config";
import type { ServiceDetailSlug } from "../../i18n/types";
import { localizePath, useTranslations } from "../../i18n/utils";
import { getServiceDetail } from "../../i18n/services";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const services = t.services;

// Image and detail page per card, paired positionally with services.cards.
// Services without a detail page have no slug.
const cardStyles: Array<{ image: ImageMetadata; slug?: ServiceDetailSlug }> = [
  { image: implantsImage, slug: "implantologija" },
  { image: orthodonticsImage, slug: "ortodoncija" },
  { image: endodonticsImage, slug: "endodoncija" },
  { image: prostheticsImage, slug: "protetika" },
  { image: aestheticImage, slug: "estetska-dentalna-medicina" },
  { image: oralSurgeryImage, slug: "oralna-kirurgija" },
  { image: periodontologyImage, slug: "parodontologija" },
  { image: xrayImage, slug: "rtg-dijagnostika" },
  { image: paediatricImage, slug: "djecja-dentalna-medicina" },
];

const cards = services.cards.map((card, index) => {
  const { image, slug } = cardStyles[index] ?? {};
  // Link only where this language has the page; see i18n/services.ts.
  const href =
    slug && getServiceDetail(slug, locale)
      ? localizePath(`/services/${slug}`, locale)
      : undefined;
  return { ...card, image, href };
});
---

<Layout
  locale={locale}
  title={services.meta.title}
  description={services.meta.description}
  overlayNav
>
  <PhotoHero
    eyebrow={services.hero.eyebrow}
    title={services.hero.title}
    image={heroImage}
    focus="70% center"
    eyebrowTone="ink"
  />

  <SectionIntro
    eyebrow={services.intro.eyebrow}
    heading={services.intro.heading}
    paragraph={services.intro.paragraph}
    measure="wide"
  />

  <!-- Service cards -->
  <section class="bg-theme-surface py-12">
    <div class="container">
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
        {
          cards.map((card) => {
            const Tag = card.href ? "a" : "div";
            return (
              <li>
                <Tag
                  href={card.href}
                  class:list={[
                    "group flex h-full flex-col overflow-hidden rounded border border-black/10 bg-theme-surface",
                    card.href && "transition-shadow hover:shadow-lg",
                  ]}
                >
                  {card.image && (
                    <div class="h-60 overflow-hidden">
                      <Image
                        src={card.image}
                        alt=""
                        widths={[400, 600, 800]}
                        sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
                        class:list={[
                          "h-full w-full object-cover",
                          card.href && "transition-transform duration-500 group-hover:scale-105",
                        ]}
                        loading="lazy"
                      />
                    </div>
                  )}
                  <div class="flex flex-1 flex-col p-6">
                    <h2 class="mb-2 text-lg font-medium leading-7 tracking-[0.02em] text-black">
                      {card.title}
                    </h2>
                    <p class="text-base leading-7 tracking-[0.02em] text-black/55">
                      {card.summary}
                    </p>
                    {card.href && (
                      <span class="mt-auto pt-8 text-base leading-7 tracking-[0.02em] text-black">
                        {t.common.learnMore}{" "}
                        <span
                          class="inline-block transition-transform group-hover:translate-x-1"
                          aria-hidden="true">&rarr;</span
                        >
                      </span>
                    )}
                  </div>
                </Tag>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <BookingBand locale={locale} />
</Layout>
