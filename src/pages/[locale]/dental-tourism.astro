import DentalTourismPage from "../../components/pages/DentalTourismPage.astro";
import { getLocalePaths } from "../../i18n/paths";
import type { Locale } from "../../i18n/config";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.params as { locale: Locale };
---

