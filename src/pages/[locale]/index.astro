---
// Home page for the locale-prefixed routes (/en, /de, /it).
import HomePage from "../../components/pages/HomePage.astro";
import { getLocalePaths } from "../../i18n/paths";
import type { Locale } from "../../i18n/config";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.params as { locale: Locale };
---

<HomePage locale={locale} />
